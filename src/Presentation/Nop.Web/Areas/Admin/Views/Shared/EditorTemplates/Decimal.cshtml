@model Decimal
@{
    var postfix = "";
    if (ViewData.ContainsKey("postfix") && ViewData["postfix"] != null)
    {
        postfix = ViewData["postfix"].ToString();
    }
}
<div class="input-postfix" data-postfix="@postfix">
    @Html.TextBox(string.Empty, Model.ToString(CultureInfo.InvariantCulture),
        new
        {
            type = "number",
            step = "any",
            @class = "form-control"
        })
    <input name="__Invariant" type="hidden" value="@Html.NameForModel()" />
</div>