@model WelcomeSlideModel

@{
    //page title
    ViewBag.PageTitle = T("Admin.ContentManagement.WelcomeSlides.AddNew").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("Welcome slides");
}

<form asp-controller="WelcomeSlide" asp-action="Create" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Admin.ContentManagement.WelcomeSlides.AddNew")
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="List">@T("Admin.ContentManagement.WelcomeSlides.BackToList")</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.SaveContinue")
            </button>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                @await Html.PartialAsync("_CreateOrUpdate", Model)
            </div>
        </div>
    </section>
</form>