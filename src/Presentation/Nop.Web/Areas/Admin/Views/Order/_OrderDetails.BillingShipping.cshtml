@using Nop.Services.Localization
@using Nop.Services.Shipping
@model OrderModel
@inject AddressSettings addressSettings
@inject ILocalizationService localizationService
@inject IShippingMethodsService shippingMethodsService

@{
    var canShipmentsView = await permissionService.AuthorizeAsync(StandardPermission.Orders.SHIPMENTS_VIEW);

    //this store collects a single, shipping-only address - prefer the shipping clone, which is what shipments use
    var orderAddress = !Model.PickupInStore && Model.ShippingAddress != null ? Model.ShippingAddress : Model.BillingAddress;

    //an address with no country gives the geocoder no region to search, and the
    //world map Google answers with is worse than none - so it decides both whether
    //the map panel is drawn and where the "view on Google Maps" link lives - unless
    //the customer dropped a pin, which needs no geocoding at all
    var showMap = !string.IsNullOrEmpty(Model.ShippingAddressGoogleMapsUrl) &&
                  (Model.ShippingAddressMapPinned || !string.IsNullOrEmpty(Model.ShippingAddress?.CountryName));

    //One row per field the store actually asks for. AddressSettings is the same
    //source the public address form reads, so switching a field off in
    //Configuration > Settings > Customer settings > Address form fields drops it
    //from this panel too, instead of leaving a column of blank labels behind.
    //A field that is switched off but still holds a value is kept: orders placed
    //before the setting changed must not quietly lose what the customer gave.
    var addressFields = new[]
    {
        (Enabled: true, Key: "FullName", Value: $"{orderAddress.FirstName} {orderAddress.LastName}".Trim()),
        (Enabled: true, Key: "Email", Value: orderAddress.Email),
        (Enabled: addressSettings.PhoneEnabled, Key: "Phone", Value: orderAddress.PhoneNumber),
        (Enabled: addressSettings.FaxEnabled, Key: "Fax", Value: orderAddress.FaxNumber),
        (Enabled: addressSettings.CompanyEnabled, Key: "Company", Value: orderAddress.Company),
        (Enabled: addressSettings.StreetAddressEnabled, Key: "Address1", Value: orderAddress.Address1),
        (Enabled: addressSettings.StreetAddress2Enabled, Key: "Address2", Value: orderAddress.Address2),
        (Enabled: addressSettings.CityEnabled, Key: "City", Value: orderAddress.City),
        (Enabled: addressSettings.CountyEnabled, Key: "County", Value: orderAddress.County),
        (Enabled: addressSettings.StateProvinceEnabled, Key: "StateProvince", Value: orderAddress.StateProvinceName),
        (Enabled: addressSettings.ZipPostalCodeEnabled, Key: "ZipPostalCode", Value: orderAddress.ZipPostalCode),
        (Enabled: addressSettings.CountryEnabled, Key: "Country", Value: orderAddress.CountryName)
    }.Where(field => field.Enabled || !string.IsNullOrWhiteSpace(field.Value)).ToList();

    //The method is picked from the store's shipping methods rather than retyped:
    //what is saved here is what the customer sees on the order, and a typo has no
    //second chance. The order's own value leads the list even when it is not one of
    //them any more - a renamed or deleted method must not be silently reassigned.
    var shippingMethodNames = new List<string>();
    if (Model.IsShippable && !Model.IsLoggedInAsVendor)
    {
        foreach (var shippingMethod in await shippingMethodsService.GetAllShippingMethodsAsync())
            shippingMethodNames.Add(await localizationService.GetLocalizedAsync(shippingMethod, method => method.Name));

        if (!string.IsNullOrEmpty(Model.ShippingMethod) && !shippingMethodNames.Contains(Model.ShippingMethod))
            shippingMethodNames.Insert(0, Model.ShippingMethod);
    }

    //The pickup address belongs to the store, not to the customer, so there is no
    //setting to read - show whichever parts of it are filled in.
    var pickupFields = Model.PickupAddress == null
        ? new List<(string Key, string Value)>()
        : new List<(string Key, string Value)>
        {
            ("Address1", Model.PickupAddress.Address1),
            ("City", Model.PickupAddress.City),
            ("County", Model.PickupAddress.County),
            ("ZipPostalCode", Model.PickupAddress.ZipPostalCode),
            ("Country", Model.PickupAddress.CountryName)
        }.Where(field => !string.IsNullOrWhiteSpace(field.Value)).ToList();
}

<div class="card-body">
    <div class="row">
        @*Where the parcel goes sits beside how it gets there. Stock nop left this
            column empty on every non-pickup order and pushed the shipping method
            to a full-width card below, so the panel opened on half a screen of
            nothing.*@
        <div class="col-md-6 card-group">
            @if (Model.IsShippable && Model.PickupInStore && Model.PickupAddress != null)
            {
                <div class="card mb-3">
                    <div class="card-header clearfix">
                        @T("Admin.Orders.Fields.PickupAddress")
                    </div>
                    <div class="card-body">
                        @foreach (var field in pickupFields)
                        {
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <div class="label-wrapper">
                                        <label class="col-form-label">
                                            @T($"Admin.Orders.Address.{field.Key}")
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-8">
                                    <div class="form-text-row">
                                        @field.Value
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(Model.PickupAddressGoogleMapsUrl) && !string.IsNullOrEmpty(Model.PickupAddress.CountryName))
                    {
                        <div class="order-address-map">
                            <iframe src="@(Model.PickupAddressGoogleMapsUrl + "&output=embed")"
                                    title="@T("Admin.Orders.Fields.PickupAddress")"
                                    loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
                        </div>
                        <div class="card-footer">
                            <div class="form-text-row">
                                <img alt="google maps" src="@Url.Content("~/css/admin/images/gmaps.ico")" />
                                <a href="@Html.Raw(Model.PickupAddressGoogleMapsUrl)" target="_blank">@T("Admin.Orders.Fields.PickupAddress.ViewOnGoogleMaps")</a>
                            </div>
                        </div>
                    }
                </div>
            }

            @*How the parcel ships and where it goes are the same set of facts, so
                they share one card. No card header either: every row below is
                labelled, and the panel this sits in is already titled "Shipping".*@
            <div class="card mb-3">
                <div class="card-body">
                    @if (Model.IsShippable)
                    {
                        <div class="form-group row">
                            <div class="col-md-4">
                                <nop-label asp-for="ShippingMethod" />
                            </div>
                            <div class="col-md-8">
                                @if (!Model.IsLoggedInAsVendor)
                                {
                                    <script>
                                        $(function () {
                                            toggleEditShippingMethod(false);
                                        });

                                        function toggleEditShippingMethod(editmode) {
                                            if (editmode) {
                                                $('#lblShippingMethod').hideElement();
                                                $('#divShippingMethod').showElement();
                                                $('#btnEditShippingMethod').hideElement();
                                                $('#btnSaveShippingMethod').showElement();
                                                $('#btnCancelShippingMethod').showElement();
                                            } else {
                                                $('#lblShippingMethod').showElement();
                                                $('#divShippingMethod').hideElement();
                                                $('#btnEditShippingMethod').showElement();
                                                $('#btnSaveShippingMethod').hideElement();
                                                $('#btnCancelShippingMethod').hideElement();
                                            }
                                        }
                                    </script>
                                    <div class="input-group input-group-short">
                                        <div id="lblShippingMethod" class="input-group-text">
                                            @Model.ShippingMethod
                                        </div>
                                        <div id="divShippingMethod">
                                            @*a plain select, not nop-select: that one renders select2, which is initialised
                                                while this div is still hidden and so measures its width as zero -
                                                an 84px box with a scrollbar on each axis. Three shipping methods
                                                need no search box anyway.*@
                                            <select asp-for="ShippingMethod" asp-items="@(new SelectList(shippingMethodNames))" class="form-control"></select>
                                        </div>
                                        <span class="input-group-append">
                                            <button type="submit" onclick="toggleEditShippingMethod(true);return false;" id="btnEditShippingMethod" class="btn btn-primary">
                                                @T("Admin.Common.Edit")
                                            </button>

                                            <button type="submit" id="btnSaveShippingMethod" name="save-shipping-method" class="btn btn-primary">
                                                @T("Admin.Common.Save")
                                            </button>
                                            <nop-action-confirmation asp-button-id="btnSaveShippingMethod" />

                                            <button type="submit" onclick="toggleEditShippingMethod(false);return false;" id="btnCancelShippingMethod" class="btn btn-secondary">
                                                @T("Admin.Common.Cancel")
                                            </button>
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <div id="lblShippingMethod">
                                        <div class="form-text-row">@Model.ShippingMethod</div>
                                    </div>
                                }
                            </div>
                        </div>

                        if (!Model.IsLoggedInAsVendor)
                        {
                            <div class="form-group row">
                                <div class="col-md-4">
                                    <nop-label asp-for="ShippingStatus" />
                                </div>
                                <div class="col-md-8">
                                    <div class="form-text-row">@Model.ShippingStatus</div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="form-group row">
                            <div class="col-md-12">
                                <div class="form-text-row">@T("Admin.Orders.ShippingInfo.NotRequired")</div>
                            </div>
                        </div>
                    }

                    @foreach (var field in addressFields)
                    {
                        <div class="form-group row">
                            <div class="col-md-4">
                                <div class="label-wrapper">
                                    <label class="col-form-label">
                                        @T($"Admin.Orders.Address.{field.Key}")
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="form-text-row">
                                    @field.Value
                                </div>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(orderAddress.FormattedCustomAddressAttributes))
                    {
                        <div class="form-group row">
                            <div class="col-md-4">
                                <div class="label-wrapper">
                                    <label class="col-form-label">@T("Admin.Orders.Address.CustomAttributes")</label>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="form-text-row">
                                    @Html.Raw(orderAddress.FormattedCustomAddressAttributes)
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (!Model.IsLoggedInAsVendor)
                {
                    <div class="card-footer">
                        @*space-between rather than the mr-auto/ml-auto pair stock uses:
                            those two are physical margins, so in the RTL admin they pushed
                            both items into the middle of the footer instead of one to each
                            end. Edit opens the address rows above it, so it leads; the map
                            link closes the footer.*@
                        <div class="form-group row justify-content-between align-items-center">
                            <div class="col-auto">
                                <a asp-action="AddressEdit" asp-route-addressId="@orderAddress.Id" asp-route-orderId="@Model.Id" class="btn btn-primary">@T("Admin.Common.Edit")</a>
                            </div>
                            @*the link normally rides with the map in the panel beside this
                                one; an address the map cannot place has no such panel, so it
                                keeps the link here*@
                            @if (!string.IsNullOrEmpty(Model.ShippingAddressGoogleMapsUrl) && !showMap)
                            {
                                <div class="col-auto">
                                    <div class="form-text-row">
                                        <img alt="google maps" src="@Url.Content("~/css/admin/images/gmaps.ico")" />
                                        <a href="@Html.Raw(Model.ShippingAddressGoogleMapsUrl)" target="_blank">@T("Admin.Orders.Fields.ShippingAddress.ViewOnGoogleMaps")</a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
        @*The facts read down one column; the map gets the other to itself. No
            country means no region for the geocoder to search in, and Google answers
            a bare district name with a world map of same-named businesses - worse
            than no map, so that address keeps the link in the card above instead.*@
        @if (showMap)
        {
            <div class="col-md-6 card-group order-address-map-col">
                <div class="card mb-3 order-address-map-card">
                    <div class="card-body">
                        <div class="order-address-map">
                            <iframe src="@(Model.ShippingAddressGoogleMapsUrl + "&output=embed")"
                                    title="@T("Admin.Orders.Fields.ShippingAddress")"
                                    loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="form-text-row">
                            <img alt="google maps" src="@Url.Content("~/css/admin/images/gmaps.ico")" />
                            <a href="@Html.Raw(Model.ShippingAddressGoogleMapsUrl)" target="_blank">@T("Admin.Orders.Fields.ShippingAddress.ViewOnGoogleMaps")</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.IsShippable)
    {
        if (canShipmentsView)
        {
            <div class="card card-default">
                <div class="card-header">
                    @T("Admin.Orders.Shipments")
                </div>
                <div class="card-body">
                    @await Html.PartialAsync("Table", new DataTablesModel
                    {
                        Name = "shipments-grid",
                        UrlRead = new DataUrl("ShipmentsByOrder", "Order", new RouteValueDictionary { [nameof(OrderShipmentSearchModel.OrderId)] = Model.Id }),
                        PrimaryKeyColumn = nameof(ShipmentModel.Id),
                        Length = Model.OrderShipmentSearchModel.PageSize,
                        LengthMenu = Model.OrderShipmentSearchModel.AvailablePageSizes,
                        ColumnCollection = new List<ColumnProperty>
                        {
                            new ColumnProperty(null)
                            {
                                Render = new RenderChildCaret(),
                                Width = "5",
                                Searchable = false,
                                ClassName =  NopColumnClassDefaults.ChildControl
                            },
                            new ColumnProperty(nameof(ShipmentModel.Id))
                            {
                                Title = T("Admin.Orders.Shipments.ID").Text,
                                Width = "50"
                            },
                            new ColumnProperty(nameof(ShipmentModel.CustomOrderNumber))
                            {
                                Title = T("Admin.Orders.Shipments.CustomOrderNumber").Text,
                                Width = "100"
                            },
                            new ColumnProperty(nameof(ShipmentModel.TrackingNumber))
                            {
                                Title = T("Admin.Orders.Shipments.TrackingNumber").Text,
                                Width = "100"
                            },
                            new ColumnProperty(nameof(ShipmentModel.TotalWeight))
                            {
                                Title = T("Admin.Orders.Shipments.TotalWeight").Text,
                                Width = "100"
                            },
                            (Model.PickupInStore ? 
                                new ColumnProperty(nameof(ShipmentModel.ReadyForPickupDate))
                                {
                                    Title = T("Admin.Orders.Shipments.ReadyForPickupDate").Text,
                                    Width = "100"
                                } : 
                                new ColumnProperty(nameof(ShipmentModel.ShippedDate))
                                {
                                    Title = T("Admin.Orders.Shipments.ShippedDate").Text,
                                    Width = "100"
                                }),
                            new ColumnProperty(nameof(ShipmentModel.DeliveryDate))
                            {
                                Title = T("Admin.Orders.Shipments.DeliveryDate").Text,
                                Width = "100"
                            },
                            new ColumnProperty(nameof(ShipmentModel.Id))
                            {
                                Title = T("Admin.Common.View").Text,
                                Width = "50",
                                Render = new RenderButtonView(new DataUrl("~/Admin/Order/ShipmentDetails/"))
                            }
                        },
                        ChildTable = new DataTablesModel
                        {
                            Name = "shipment-items-grid",
                            UrlRead = new DataUrl("ShipmentsItemsByShipmentId", "Order", null),
                            IsChildTable = true,
                            Length = Model.OrderShipmentSearchModel.PageSize,
                            LengthMenu = Model.OrderShipmentSearchModel.AvailablePageSizes,
                            Filters = new List<FilterParameter>
                            {
                                new FilterParameter(nameof(ShipmentItemSearchModel.ShipmentId), nameof(ShipmentModel.Id), true)
                            },
                            ColumnCollection = new List<ColumnProperty>
                            {
                                new ColumnProperty(nameof(ShipmentItemModel.ProductName))
                                {
                                    Title = T("Admin.Orders.Shipments.Products.ProductName").Text,
                                    Width = "400"
                                },
                                new ColumnProperty(nameof(ShipmentItemModel.ShippedFromWarehouse))
                                {
                                    Title = T("Admin.Orders.Shipments.Products.Warehouse").Text,
                                    Width = "150"
                                },
                                new ColumnProperty(nameof(ShipmentItemModel.QuantityInThisShipment))
                                {
                                    Title = T("Admin.Orders.Shipments.Products.QtyShipped").Text,
                                    Width = "150"
                                },
                                new ColumnProperty(nameof(ShipmentItemModel.ItemWeight))
                                {
                                    Title = T("Admin.Orders.Shipments.Products.ItemWeight").Text,
                                    Width = "150"
                                },
                                new ColumnProperty(nameof(ShipmentItemModel.ItemDimensions))
                                {
                                    Title = T("Admin.Orders.Shipments.Products.ItemDimensions").Text,
                                    Width = "150"
                                }
                            }
                        }
                    })
                </div>
                @if (Model.CanAddNewShipments)
                {
                    <div class="card-footer">
                        <button type="submit" id="btnAddNewShipment" name="btnAddNewShipment" onclick="javascript:setLocation('@(Url.Action("AddShipment", "Order", new { id = Model.Id }))'); return false;" class="btn btn-primary">
                            @T("Admin.Orders.Shipments.AddNew")
                        </button>
                    </div>
                }
            </div>
        }
    }
</div>
