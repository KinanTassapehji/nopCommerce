@inject Nop.Core.Domain.StoreInformationSettings storeInformationSettings
@*Every way to reach the store, as tappable cards above the contact form. Each channel is set in
    admin (Configuration > Settings > General settings > Social media and contact) and a card only
    shows when its channel is filled in. Colours come from whichever theme is loaded.*@
@{
    var phone = storeInformationSettings.ContactPhoneNumber?.Trim();
    var email = storeInformationSettings.ContactEmail?.Trim();
    var channels = new List<(string CssClass, string Href, string Label, string Value, bool External)>();
    if (!string.IsNullOrEmpty(phone))
        channels.Add(("phone", "tel:" + new string(phone.Where(c => char.IsDigit(c) || c == '+').ToArray()), T("ContactUs.Channels.Phone").Text, phone, false));
    if (!string.IsNullOrWhiteSpace(storeInformationSettings.WhatsAppLink))
        channels.Add(("whatsapp", storeInformationSettings.WhatsAppLink, T("Footer.FollowUs.WhatsApp").Text, T("ContactUs.Channels.WhatsApp.Hint").Text, true));
    if (!string.IsNullOrEmpty(email))
        channels.Add(("email", "mailto:" + email, T("ContactUs.Channels.Email").Text, email, false));
    if (!string.IsNullOrWhiteSpace(storeInformationSettings.FacebookLink))
        channels.Add(("facebook", storeInformationSettings.FacebookLink, T("Footer.FollowUs.Facebook").Text, T("ContactUs.Channels.Follow").Text, true));
    if (!string.IsNullOrWhiteSpace(storeInformationSettings.InstagramLink))
        channels.Add(("instagram", storeInformationSettings.InstagramLink, T("Footer.FollowUs.Instagram").Text, T("ContactUs.Channels.Follow").Text, true));
}
@if (channels.Count > 0)
{
    <style>
        .contact-channels {
            --cc-accent: var(--tm-teal-deep, var(--ar-blue, #02787e));
            --cc-tint: var(--tm-teal-tint, var(--ar-blue-tint, #e6f4f4));
            --cc-border: var(--tm-teal-border, var(--ar-blue-border, #b3dedc));
            --cc-line: var(--tm-line, var(--ar-line, #dfe5e5));
            --cc-ink: var(--tm-ink, var(--ar-ink, #10201f));
            --cc-muted: var(--tm-ink-muted, var(--ar-ink-muted, #5c6b6a));
            --cc-radius: var(--tm-radius, var(--ar-radius, 12px));
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 12px;
            margin: 0 0 32px;
            padding: 0;
            list-style: none;
        }
        .contact-channels a {
            display: flex;
            align-items: center;
            gap: 14px;
            height: 100%;
            padding: 14px 16px;
            border: 1px solid var(--cc-line);
            border-radius: var(--cc-radius);
            background: var(--tm-surface, var(--ar-surface, #fff));
            color: var(--cc-ink);
            text-align: start;
            transition: border-color .18s ease, background .18s ease;
        }
        .contact-channels a:hover,
        .contact-channels a:focus-visible {
            border-color: var(--cc-border);
            background: var(--cc-tint);
        }
        .contact-channels .contact-channel-icon {
            display: inline-flex;
            flex: none;
            align-items: center;
            justify-content: center;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: var(--cc-tint);
            color: var(--cc-accent);
        }
        .contact-channels svg {
            width: 22px;
            height: 22px;
            fill: currentColor;
        }
        .contact-channels svg.stroke {
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }
        .contact-channels .contact-channel-text {
            display: grid;
            min-width: 0;
        }
        .contact-channels strong {
            font-size: 15px;
            line-height: 22px;
        }
        .contact-channels .contact-channel-value {
            color: var(--cc-muted);
            font-size: 13px;
            line-height: 20px;
            overflow-wrap: anywhere;
        }
        /* phone numbers and addresses read left to right in an Arabic page too */
        .contact-channels .phone .contact-channel-value,
        .contact-channels .email .contact-channel-value {
            direction: ltr;
            unicode-bidi: isolate;
            text-align: start;
        }
    </style>
    <ul class="contact-channels">
        @foreach (var channel in channels)
        {
            <li class="@channel.CssClass">
                <a href="@channel.Href" target="@(channel.External ? "_blank" : null)" rel="@(channel.External ? "noopener noreferrer" : null)">
                    <span class="contact-channel-icon">
                        @switch (channel.CssClass)
                        {
                            case "phone":
                                <svg class="stroke" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>
                                break;
                            case "email":
                                <svg class="stroke" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
                                break;
                            case "whatsapp":
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47s1.06 2.87 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.23 1.36.19 1.87.12.57-.09 1.75-.71 2-1.4.25-.69.25-1.28.17-1.4-.07-.13-.27-.2-.57-.35zM12.05 21.7h-.02a9.6 9.6 0 01-4.9-1.34l-.35-.21-3.64.95.97-3.55-.23-.36a9.58 9.58 0 01-1.47-5.13c0-5.3 4.32-9.61 9.63-9.61a9.55 9.55 0 016.8 2.82 9.5 9.5 0 012.81 6.8c0 5.3-4.32 9.62-9.6 9.62zM20.5 3.49A11.5 11.5 0 0012.05 0C5.66 0 .46 5.2.46 11.58c0 2.04.53 4.03 1.55 5.79L.36 24l6.78-1.78a11.57 11.57 0 005.53 1.41h.01c6.38 0 11.58-5.2 11.58-11.58 0-3.1-1.2-6-3.39-8.19z" /></svg>
                                break;
                            case "facebook":
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.49-3.91 3.77-3.91 1.09 0 2.24.2 2.24.2v2.47h-1.26c-1.24 0-1.63.78-1.63 1.57v1.88h2.78l-.45 2.91h-2.33V22c4.78-.76 8.44-4.92 8.44-9.94z" /></svg>
                                break;
                            case "instagram":
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.26.07 1.64.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.26.06-1.64.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23-.06-1.26-.07-1.64-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.26-.06 1.64-.07 4.85-.07zM12 0C8.74 0 8.33.01 7.05.07c-1.28.06-2.15.26-2.91.56-.79.31-1.46.72-2.13 1.38C1.35 2.68.94 3.35.63 4.14c-.3.76-.5 1.63-.56 2.91C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.28.26 2.15.56 2.91.31.79.72 1.46 1.38 2.13.67.67 1.34 1.08 2.13 1.38.76.3 1.63.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.28-.06 2.15-.26 2.91-.56.79-.31 1.46-.72 2.13-1.38.67-.67 1.08-1.34 1.38-2.13.3-.76.5-1.63.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.28-.26-2.15-.56-2.91-.31-.79-.72-1.46-1.38-2.13C21.32 1.35 20.65.94 19.86.63c-.76-.3-1.63-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 100 12.32 6.16 6.16 0 000-12.32zm0 10.16a4 4 0 110-8 4 4 0 010 8zm7.85-10.4a1.44 1.44 0 11-2.88 0 1.44 1.44 0 012.88 0z" /></svg>
                                break;
                        }
                    </span>
                    <span class="contact-channel-text">
                        <strong>@channel.Label</strong>
                        <span class="contact-channel-value">@channel.Value</span>
                    </span>
                </a>
            </li>
        }
    </ul>
}