@model PasswordRecoveryModel
@{
    Layout = "_ColumnsOne";

    //title
    NopHtml.AddTitleParts(T("PageTitle.PasswordRecovery").Text);
    //page class
    NopHtml.AppendPageCssClassParts("html-password-recovery-page");
}
<div class="page password-recovery-page">
    <div class="page-title">
        <h1>@T("Account.PasswordRecovery")</h1>
    </div>
    <div class="page-body">
        <form asp-route="@NopRouteNames.Standard.PASSWORD_RECOVERY" method="post">
            <div asp-validation-summary="ModelOnly" class="message-error"></div>
            @if (Model.PhoneEnabled)
            {
                @*by phone first: most customers have no email*@
                <p class="tooltip">@T("Account.PasswordRecovery.PhoneTooltip")</p>
                <section class="fieldset">
                    <div class="form-fields">
                        <div class="inputs">
                            <label asp-for="Phone" asp-postfix=":"></label>
                            <div class="phone-input">
                                @await Html.PartialAsync("_PhoneCountry", (Model.PhoneCountry, Model.AvailablePhoneCountries))
                                <input asp-for="Phone" type="tel" dir="ltr" autocomplete="tel-national" />
                            </div>
                            <span asp-validation-for="Phone"></span>
                        </div>
                    </div>
                </section>
                <p class="tooltip">@T("Account.PasswordRecovery.OrByEmail")</p>
            }
            else
            {
                <p class="tooltip">@T("Account.PasswordRecovery.Tooltip")</p>
            }
            <section class="fieldset">
                <div class="form-fields">
                    <div class="inputs">
                        <label asp-for="Email" asp-postfix=":"></label>
                        <input asp-for="Email" class="email" />
                        @if (!Model.PhoneEnabled)
                        {
                            <nop-required />
                        }
                        <span asp-validation-for="Email"></span>
                    </div>
                </div>
                @if (Model.DisplayCaptcha)
                {
                    <nop-captcha />
                }
            </section>
            <section class="buttons">
                <button type="submit" name="send-email" class="button-1 password-recovery-button">@T("Account.PasswordRecovery.RecoverButton")</button>
            </section>
        </form>
    </div>
</div>