@using Nop.Services.Localization
@using Nop.Core
@inject ILocalizationService localizationService
@inject IStoreContext storeContext
@inject IWorkContext workContext
@inject Nop.Services.Media.IPictureService pictureService
@inject Nop.Core.Domain.Common.HomepageBannerSettings homepageBannerSettings
@inject Nop.Services.Common.IHomepageFeatureService homepageFeatureService

@{
    Layout = "_ColumnsOne";

    var homepageTitle = await localizationService.GetLocalizedAsync(await storeContext.GetCurrentStoreAsync(), s => s.HomepageTitle);

    //title
    if (!string.IsNullOrEmpty(homepageTitle))
    {
        NopHtml.AddTitleParts(homepageTitle);
    }

    var homepageDescription = await localizationService.GetLocalizedAsync(await storeContext.GetCurrentStoreAsync(), s => s.HomepageDescription);

    //meta
    if (!string.IsNullOrEmpty(homepageDescription))
    {
        NopHtml.AddMetaDescriptionParts(homepageDescription);
    }

    //page class
    NopHtml.AppendPageCssClassParts("html-home-page");
}
@*the welcome tour, once per browser (Content management > Welcome slides)*@
@{ await Html.RenderPartialAsync("_WelcomeSlides"); }
<div class="page home-page">
    <div class="page-body">
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HomepageTop })
        @*Order, for selling - product bands never run back to back: the hero, then offers (the hook),
            the categories (where to go), new arrivals, the reasons to buy, the curated picks, brands,
            the two category rails, the call to action, what others buy, news, recently viewed.*@
        @await Component.InvokeAsync(typeof(HomepageDealsViewComponent))
        @await Component.InvokeAsync(typeof(TopicBlockViewComponent), new { systemName = "HomepageText" })
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HomepageBeforeCategories })
        @await Component.InvokeAsync(typeof(HomepageCategoriesViewComponent))
        @await Component.InvokeAsync(typeof(FilterLevelValueSearchViewComponent))
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HomepageBeforeProducts })
        @*the reasons to buy, between the first two product bands (Kinan did not want them first after the slider). The admin manages the list (Content
            management > Home page features): text per language, icon, order, published*@
        @{
            var homepageFeatures = await homepageFeatureService.GetAllHomepageFeaturesAsync();
        }
        @if (homepageFeatures.Any())
        {
            <ul class="home-usp">
                @foreach (var feature in homepageFeatures)
                {
                    var hint = await localizationService.GetLocalizedAsync(feature, f => f.Hint);
                    <li>
                        @await Html.PartialAsync("_HomepageFeatureIcon", feature.Icon)
                        <div>
                            <strong>@(await localizationService.GetLocalizedAsync(feature, f => f.Title))</strong>
                            @if (!string.IsNullOrEmpty(hint))
                            {
                                <span>@hint</span>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
        @await Component.InvokeAsync(typeof(HomepageProductsViewComponent))
        @*rendered with the page, not the OCarousel band that waited for a scroll and a POST*@
        @await Component.InvokeAsync(typeof(ManufacturerNavigationViewComponent), new { currentManufacturerId = 0 })
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HomepageBeforeBestSellers })
        @*one call to action between the category rails and the bestsellers. No all-products feed: the home
            page shows the products marked "show on home page" (the band above) - the catalogue is a tap away.
            The admin edits it under Content management > Home page banner*@
        @if (homepageBannerSettings.Enabled)
        {
            var languageId = (await workContext.GetWorkingLanguageAsync()).Id;
            var ctaTitle = await localizationService.GetLocalizedSettingAsync(homepageBannerSettings, s => s.Title, languageId, 0);
            var ctaText = await localizationService.GetLocalizedSettingAsync(homepageBannerSettings, s => s.Text, languageId, 0);
            var ctaButton = await localizationService.GetLocalizedSettingAsync(homepageBannerSettings, s => s.ButtonText, languageId, 0);
            var ctaCover = homepageBannerSettings.PictureId > 0
                ? await pictureService.GetPictureUrlAsync(homepageBannerSettings.PictureId, showDefaultPicture: false)
                : null;
            <section class="home-cta@(string.IsNullOrEmpty(ctaCover) ? "" : " has-cover")" style="@(string.IsNullOrEmpty(ctaCover) ? null : $"background-image:url('{ctaCover}')")">
                <div>
                    @if (!string.IsNullOrEmpty(ctaTitle))
                    {
                        <h2>@ctaTitle</h2>
                    }
                    @if (!string.IsNullOrEmpty(ctaText))
                    {
                        <p>@ctaText</p>
                    }
                </div>
                @if (!string.IsNullOrEmpty(ctaButton))
                {
                    <a class="button-1" href="@(string.IsNullOrEmpty(homepageBannerSettings.ButtonUrl) ? Url.RouteUrl(NopRouteNames.General.CATEGORIES) : homepageBannerSettings.ButtonUrl)">@ctaButton</a>
                }
            </section>
        }
        @await Component.InvokeAsync(typeof(HomepageBestSellersViewComponent))
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HomepageBeforeNews })
        @await Component.InvokeAsync(typeof(HomepageNewsViewComponent))
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HomepageBeforePoll })
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HomepageBottom })
    </div>
</div>

