@using Nop.Services.Localization
@using Nop.Core
@inject ILocalizationService localizationService
@inject IStoreContext storeContext
@inject Nop.Services.Common.IHomepageFeatureService homepageFeatureService

@{
    Layout = "_ColumnsOne";

    var homepageTitle = await localizationService.GetLocalizedAsync(await storeContext.GetCurrentStoreAsync(), s => s.HomepageTitle);

    //title
    if (!string.IsNullOrEmpty(homepageTitle))
    {
        NopHtml.AddTitleParts(homepageTitle);
    }

    var homepageDescription = await localizationService.GetLocalizedAsync(await storeContext.GetCurrentStoreAsync(), s => s.HomepageDescription);

    //meta
    if (!string.IsNullOrEmpty(homepageDescription))
    {
        NopHtml.AddMetaDescriptionParts(homepageDescription);
    }

    //page class
    NopHtml.AppendPageCssClassParts("html-home-page");
}
<div class="page home-page">
    <div class="page-body">
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HomepageTop })
        @*the reasons to buy here, straight under the hero. The admin manages the list (Content
            management > Home page features): text per language, icon, order, published*@
        @{
            var homepageFeatures = await homepageFeatureService.GetAllHomepageFeaturesAsync();
        }
        @if (homepageFeatures.Any())
        {
            <ul class="home-usp">
                @foreach (var feature in homepageFeatures)
                {
                    var hint = await localizationService.GetLocalizedAsync(feature, f => f.Hint);
                    <li>
                        @await Html.PartialAsync("_HomepageFeatureIcon", feature.Icon)
                        <div>
                            <strong>@(await localizationService.GetLocalizedAsync(feature, f => f.Title))</strong>
                            @if (!string.IsNullOrEmpty(hint))
                            {
                                <span>@hint</span>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
        @await Component.InvokeAsync(typeof(TopicBlockViewComponent), new { systemName = "HomepageText" })
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HomepageBeforeCategories })
        @await Component.InvokeAsync(typeof(HomepageCategoriesViewComponent))
        @await Component.InvokeAsync(typeof(FilterLevelValueSearchViewComponent))
        @await Component.InvokeAsync(typeof(HomepageDealsViewComponent))
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HomepageBeforeProducts })
        @await Component.InvokeAsync(typeof(HomepageProductsViewComponent))
        @*one call to action between the curated bands and the long tail below*@
        <section class="home-cta">
            <div>
                <h2>@T("Homepage.Cta.Title")</h2>
                <p>@T("Homepage.Cta.Text")</p>
            </div>
            <a class="button-1" href="@Url.RouteUrl(NopRouteNames.General.CATEGORIES)">@T("Homepage.Cta.Button")</a>
        </section>
        @*rendered with the page, not the OCarousel band that waited for a scroll and a POST*@
        @await Component.InvokeAsync(typeof(ManufacturerNavigationViewComponent), new { currentManufacturerId = 0 })
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HomepageBeforeBestSellers })
        @await Component.InvokeAsync(typeof(HomepageBestSellersViewComponent))
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HomepageBeforeNews })
        @await Component.InvokeAsync(typeof(HomepageNewsViewComponent))
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HomepageBeforePoll })
        @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HomepageBottom })
        <section class="product-grid home-page-all-products" id="home-products">
            @*the heading only makes sense once the first page of the feed has landed*@
            <h2 class="title" id="home-products-title" hidden>
                <span>@T("Homepage.AllProducts")</span>
                <a class="view-all" href="@Url.RouteUrl(NopRouteNames.General.CATEGORIES)">@T("Homepage.ViewAll")<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
            </h2>
            <div class="item-grid" id="home-products-grid"></div>
            <div class="home-products-loader" id="home-products-loader" role="status" aria-label="@T("Homepage.AllProducts.Loading")" hidden><span></span><span></span><span></span></div>
            <div id="home-products-pager"></div>
        </section>
        <div id="home-products-sentinel"></div>
    </div>
</div>

<script asp-location="Footer">
    $(function () {
        //the all-products feed is paged on desktop and infinitely scrolled on mobile
        //ponytail: 1000px is the theme's own mobile/desktop split; the mode is picked once, a resize
        //across the breakpoint keeps whatever the page loaded with
        var url = '@Url.RouteUrl(NopRouteNames.Ajax.HOMEPAGE_PRODUCTS)';
        var $grid = $('#home-products-grid'), $pager = $('#home-products-pager'), $loader = $('#home-products-loader');
        var sentinel = document.getElementById('home-products-sentinel');
        var infinite = window.matchMedia('(max-width: 1000px)').matches;
        var page = 1, busy = false;
        //what the bands above already show - read once, while the feed is still empty, so every
        //page is cut from the same list and the pager's totals hold
        var excludedIds = $.map($('[data-productid]'), function (el) { return $(el).data('productid'); }).join(',');

        var observer = new IntersectionObserver(function (entries) {
            if (entries[0].isIntersecting)
                load(page);
        }, { rootMargin: '400px' });

        function load(pageNumber, scroll) {
            if (busy)
                return;
            busy = true;
            $loader.prop('hidden', false);
            $.get(url, { pageNumber: pageNumber, excludedIds: excludedIds }, function (html) {
                $loader.prop('hidden', true);
                if (!$.trim(html)) {
                    //no more products
                    observer.disconnect();
                    $pager.empty();
                    return;
                }
                page = pageNumber + 1;
                var $html = $(html);
                if (!infinite)
                    $grid.empty();
                $grid.append($html.filter('.item-box'));
                $('#home-products-title').prop('hidden', !$grid.children().length);
                if (!infinite)
                    $pager.empty().append($html.filter('.pager'));
                //a new page starts at its own heading, not wherever the pager left the scroll
                if (scroll)
                    document.getElementById('home-products').scrollIntoView({ block: 'start' });
                busy = false;
                if (infinite) {
                    //re-trigger when the sentinel is still visible (short or fully skipped page)
                    observer.unobserve(sentinel);
                    observer.observe(sentinel);
                }
            }).fail(function () { busy = false; $loader.prop('hidden', true); });
        }

        $pager.on('click', '[data-page]', function (e) {
            e.preventDefault();
            load($(this).data('page'), true);
        });

        if (infinite)
            observer.observe(sentinel);
        else
            load(1);
    });
</script>
<script asp-location="Footer">
    $(function () {
        //the curated bands are rails: a thumb swipes them, but a wheel cannot
        //scroll sideways, so a mouse gets a pair of arrows in the band heading
        var chevron = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>';
        var forward = $('html').attr('dir') === 'rtl' ? -1 : 1;

        $('.home-page-product-grid, .home-page-deals, .bestsellers').each(function () {
            var rail = $(this).find('.item-grid')[0], $title = $(this).children('.title');
            if (!rail || !$title.length)
                return;

            var $prev = $('<button type="button" class="rail-prev" aria-label="@T("Pager.Previous")">' + chevron + '</button>');
            var $next = $('<button type="button" class="rail-next" aria-label="@T("Pager.Next")">' + chevron + '</button>');
            var $nav = $('<span class="rail-nav"></span>').append($prev, $next).appendTo($title);

            function sync() {
                //scrollLeft counts down from 0 in RTL
                var at = Math.abs(rail.scrollLeft), max = rail.scrollWidth - rail.clientWidth;
                //a band that fits needs no arrows; 4px absorbs sub-pixel widths
                $nav.prop('hidden', max < 4);
                $prev.prop('disabled', at < 4);
                $next.prop('disabled', at > max - 4);
            }

            $nav.on('click', 'button', function () {
                //just short of a full view, so the card at the edge stays in sight;
                //scroll snapping lands it on a card boundary
                var step = rail.clientWidth * 0.9 * forward;
                rail.scrollBy({ left: $(this).hasClass('rail-prev') ? -step : step });
            });
            $(rail).on('scroll', sync);
            $(window).on('resize', sync);
            sync();
        });
    });
</script>
