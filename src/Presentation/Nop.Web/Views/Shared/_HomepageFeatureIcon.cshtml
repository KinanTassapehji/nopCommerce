@model Nop.Core.Domain.Common.HomepageFeatureIcon

@*One icon of the home page trust strip - the strip itself (Home/Index) and the admin's icon
    picker (HomepageFeature/_CreateOrUpdate) both draw from here. 24px stroke marks in
    currentColor, so the brand colour comes from wherever they sit.*@
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Model)
    {
        case Nop.Core.Domain.Common.HomepageFeatureIcon.Delivery:
            <path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z" /><circle cx="7" cy="18" r="2" /><circle cx="17" cy="18" r="2" />
            break;
        case Nop.Core.Domain.Common.HomepageFeatureIcon.CashOnDelivery:
            <rect x="2" y="6" width="20" height="12" rx="2" /><circle cx="12" cy="12" r="3" /><path d="M6 12h.01M18 12h.01" />
            break;
        case Nop.Core.Domain.Common.HomepageFeatureIcon.Genuine:
            <path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6z" /><path d="M9 12l2 2 4-4" />
            break;
        case Nop.Core.Domain.Common.HomepageFeatureIcon.Support:
            <path d="M4 13v-2a8 8 0 0116 0v2" /><rect x="3" y="13" width="4" height="6" rx="1.5" /><rect x="17" y="13" width="4" height="6" rx="1.5" /><path d="M19 19a3 3 0 01-3 3h-3" />
            break;
        case Nop.Core.Domain.Common.HomepageFeatureIcon.Returns:
            <path d="M3 12a9 9 0 109-9 9.7 9.7 0 00-6.7 2.8L3 8" /><path d="M3 3v5h5" />
            break;
        case Nop.Core.Domain.Common.HomepageFeatureIcon.SecurePayment:
            <rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 018 0v4" /><path d="M12 15v2" />
            break;
        case Nop.Core.Domain.Common.HomepageFeatureIcon.Gift:
            <rect x="3" y="8" width="18" height="4" rx="1" /><path d="M5 12v8a1 1 0 001 1h12a1 1 0 001-1v-8M12 8v13" /><path d="M12 8C10.5 5 7 4.5 7 6.5S10 8 12 8zM12 8c1.5-3 5-3.5 5-1.5S14 8 12 8z" />
            break;
        case Nop.Core.Domain.Common.HomepageFeatureIcon.Offers:
            <path d="M3 12V4a1 1 0 011-1h8l9 9-9 9z" /><circle cx="7.5" cy="7.5" r="1.5" />
            break;
        case Nop.Core.Domain.Common.HomepageFeatureIcon.Clock:
            <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
            break;
        case Nop.Core.Domain.Common.HomepageFeatureIcon.Phone:
            <path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z" />
            break;
        case Nop.Core.Domain.Common.HomepageFeatureIcon.Store:
            <path d="M3 9l2-5h14l2 5" /><path d="M3 9a3 3 0 006 0 3 3 0 006 0 3 3 0 006 0" /><path d="M5 12v8h14v-8M10 20v-5h4v5" />
            break;
        default:
            <path d="M12 3l2.8 5.7 6.2.9-4.5 4.4 1 6.2-5.5-2.9-5.5 2.9 1-6.2L3 9.6l6.2-.9z" />
            break;
    }
</svg>
