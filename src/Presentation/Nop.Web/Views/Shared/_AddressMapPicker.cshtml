@model AddressModel
@using Nop.Core
@using Nop.Services.Configuration
@inject ISettingService settingService
@inject IWorkContext workContext
@*
    Google map pin picker for the public address form.
    Configured from Admin > Configuration > Settings > All settings (no dedicated UI on purpose):
      googlemappicker.apikey              - Google key with Maps JavaScript API + Geocoding API enabled
      googlemappicker.locationattributeid - id of the custom address attribute (textbox) that stores "lat,lng"
      googlemappicker.defaultcenter       - "lat,lng" the map opens on when the address has no pin yet
    Falls back to the NopStation address validator's key if ours is not set.
*@
@{
    var apiKey = await settingService.GetSettingByKeyAsync<string>("googlemappicker.apikey")
        ?? await settingService.GetSettingByKeyAsync<string>("googleaddressvalidatorsettings.googleapikey");
    var locationAttributeId = await settingService.GetSettingByKeyAsync<int>("googlemappicker.locationattributeid");
    var locationAttribute = Model.CustomAddressAttributes?.FirstOrDefault(attribute => attribute.Id == locationAttributeId);
    var defaultCenter = await settingService.GetSettingByKeyAsync("googlemappicker.defaultcenter", "33.5138,36.2765");
    var language = (await workContext.GetWorkingLanguageAsync()).UniqueSeoCode;
    //unique per form - the one page checkout keeps a billing and a shipping form in the same DOM
    var mapId = $"{Html.IdFor(model => model.Id)}_map";
}
@if (!string.IsNullOrWhiteSpace(apiKey) && locationAttribute != null)
{
    @*kept here rather than in a theme stylesheet so the two stores' themes stay out of it*@
    <style>
        .address-map-canvas { width: 100%; height: 280px; margin-top: 8px; border-radius: 6px; }
        .address-map-search { display: block; box-sizing: border-box; width: 100%; margin-top: 8px; }
        .address-map-hint { display: block; margin-top: 4px; font-size: .9em; opacity: .75; }
        .address-map-unlock { margin-top: 4px; font-size: .9em; }
    </style>
    <div class="inputs address-map">
        <label for="@(mapId)_search">@locationAttribute.Name:</label>
        @*not a named field - it must never be posted with the address*@
        <input type="search" id="@(mapId)_search" class="address-map-search" autocomplete="off"
               placeholder="@T("Address.Fields.MapLocation.Search")" />
        <button type="button" class="button-2 address-map-locate" id="@(mapId)_locate">@T("Address.Fields.MapLocation.UseMyLocation")</button>
        @*no map until there is something to show it for - a search, the customer's location, or a pin the address already has*@
        <div id="@mapId" class="address-map-canvas" style="display: none;"></div>
        <span class="address-map-hint" id="@(mapId)_hint" style="display: none;">@T("Address.Fields.MapLocation.Hint")</span>
        <a href="#" class="address-map-unlock" id="@(mapId)_unlock" style="display: none;">@T("Address.Fields.MapLocation.EditManually")</a>
    </div>

    <script>
        window.AddressMap = window.AddressMap || (function () {
            var loading;

            function loadApi(key, language) {
                if (window.google && window.google.maps)
                    return Promise.resolve();
                if (!loading) {
                    loading = new Promise(function (resolve, reject) {
                        window.__addressMapApiReady = resolve;
                        var script = document.createElement('script');
                        script.async = true;
                        script.onerror = reject;
                        script.src = 'https://maps.googleapis.com/maps/api/js?key=' + encodeURIComponent(key) +
                            '&language=' + encodeURIComponent(language) + '&callback=__addressMapApiReady';
                        document.head.appendChild(script);
                    });
                }
                return loading;
            }

            function parsePoint(value) {
                var parts = (value || '').split(',');
                var lat = parseFloat(parts[0]), lng = parseFloat(parts[1]);
                return isFinite(lat) && isFinite(lng) ? { lat: lat, lng: lng } : null;
            }

            function component(components, type) {
                for (var i = 0; i < components.length; i++)
                    if (components[i].types.indexOf(type) >= 0)
                        return components[i].long_name;
                return '';
            }

            function init(options) {
                var byId = function (id) { return id ? document.getElementById(id) : null; };
                var canvas = byId(options.mapId);
                if (!canvas || canvas.dataset.ready)
                    return;
                canvas.dataset.ready = '1';

                var location = byId(options.locationFieldId),
                    search = byId(options.searchFieldId),
                    locate = byId(options.locateButtonId),
                    unlock = byId(options.unlockLinkId),
                    hint = byId(options.hintId);

                //the fields the pin owns - whatever google has nothing for stays the customer's to type
                var owned = [byId(options.cityFieldId), byId(options.countyFieldId),
                             byId(options.streetFieldId), byId(options.zipFieldId)];

                function fill(field, value) {
                    if (!field)
                        return;
                    if (value) {
                        field.value = value;
                        field.readOnly = true;
                    }
                    else {
                        field.readOnly = false;
                    }
                }

                //the pin is the input - no reason to show the raw "lat,lng" textbox as well
                var rawInput = location && location.closest('.inputs');
                if (rawInput)
                    rawInput.style.display = 'none';

                if (locate && !navigator.geolocation)
                    locate.style.display = 'none';

                //google's street data is thin outside the main roads, so never leave a customer stuck
                //with a wrong address they cannot correct
                if (unlock)
                    unlock.addEventListener('click', function (e) {
                        e.preventDefault();
                        owned.forEach(function (field) { if (field) field.readOnly = false; });
                        unlock.style.display = 'none';
                    });

                function degrade() {
                    //google unreachable - put the plain "lat,lng" textbox back so the address can still be saved
                    var block = canvas.closest('.address-map');
                    if (block)
                        block.style.display = 'none';
                    if (rawInput)
                        rawInput.style.display = '';
                }

                //the canvas has to be on screen before the map is built: google sizes the container once,
                //and a display:none one measures zero and then paints grey until something resizes it
                function reveal() {
                    canvas.style.display = '';
                    if (hint)
                        hint.style.display = '';
                }

                var map, marker, geocoder, mapPromise;

                function toPoint(latLng) {
                    return { lat: latLng.lat(), lng: latLng.lng() };
                }

                function drop(point, zoom) {
                    marker.setPosition(point);
                    marker.setVisible(true);
                    map.panTo(point);
                    if (zoom)
                        map.setZoom(zoom);
                    if (location)
                        location.value = point.lat.toFixed(6) + ',' + point.lng.toFixed(6);
                    geocoder.geocode({ location: point }, function (results, status) {
                        if (status !== 'OK' || !results.length)
                            return;
                        var parts = results[0].address_components;
                        fill(byId(options.cityFieldId), component(parts, 'locality') || component(parts, 'administrative_area_level_2') || component(parts, 'administrative_area_level_1'));
                        fill(byId(options.countyFieldId), component(parts, 'neighborhood') || component(parts, 'sublocality_level_1') || component(parts, 'sublocality') || component(parts, 'locality'));
                        fill(byId(options.streetFieldId), component(parts, 'route'));
                        fill(byId(options.zipFieldId), component(parts, 'postal_code'));
                        if (unlock)
                            unlock.style.display = '';
                    });
                }

                function buildMap() {
                    var pinned = parsePoint(location && location.value);
                    map = new google.maps.Map(canvas, {
                        center: pinned || parsePoint(options.defaultCenter) || { lat: 0, lng: 0 },
                        zoom: pinned ? 17 : 12,
                        mapTypeControl: false,
                        streetViewControl: false,
                        fullscreenControl: false
                    });
                    // ponytail: google.maps.Marker is deprecated but still served and needs no cloud-side map id.
                    // Move to AdvancedMarkerElement when you create a map id for custom styling anyway.
                    marker = new google.maps.Marker({ map: map, position: map.getCenter(), draggable: true, visible: !!pinned });
                    geocoder = new google.maps.Geocoder();

                    map.addListener('click', function (e) { drop(toPoint(e.latLng)); });
                    marker.addListener('dragend', function (e) { drop(toPoint(e.latLng)); });

                    //let it settle into its first layout before anything reads getBounds() off it
                    return new Promise(function (resolve) {
                        google.maps.event.addListenerOnce(map, 'idle', function () { resolve(); });
                    });
                }

                //nothing is fetched - and no map load is billed - until the customer asks for the map
                function ensureMap() {
                    if (!mapPromise)
                        mapPromise = loadApi(options.apiKey, options.language)
                            .then(buildMap)
                            .catch(function (error) { degrade(); throw error; });
                    return mapPromise;
                }

                //a rejection here has already been handled by degrade() - swallowing it only keeps the console clean
                function show(then) {
                    reveal();
                    ensureMap().then(then || function () { }).catch(function () { });
                }

                if (search)
                    search.addEventListener('keydown', function (e) {
                        if (e.key !== 'Enter')
                            return;
                        //the box sits inside the address form - enter must not submit it
                        e.preventDefault();
                        if (!search.value.trim())
                            return;
                        show(function () {
                            //bias to what the customer is looking at, so "المزة" lands in the right city
                            geocoder.geocode({ address: search.value, bounds: map.getBounds() }, function (results, status) {
                                if (status === 'OK' && results.length)
                                    drop(toPoint(results[0].geometry.location), 17);
                            });
                        });
                    });

                if (locate)
                    locate.addEventListener('click', function () {
                        navigator.geolocation.getCurrentPosition(function (position) {
                            show(function () {
                                drop({ lat: position.coords.latitude, lng: position.coords.longitude }, 17);
                            });
                        }, function () {
                            //refused, or a plain-http origin the browser will not locate on at all - open the
                            //map anyway rather than dead-ending, so the pin can still be dropped by hand
                            show();
                        });
                    });

                //an address that already carries a pin opens on it
                if (parsePoint(location && location.value))
                    show();
            }

            return { init: init };
        })();

        AddressMap.init({
            mapId: '@mapId',
            searchFieldId: '@(mapId)_search',
            locateButtonId: '@(mapId)_locate',
            hintId: '@(mapId)_hint',
            unlockLinkId: '@(mapId)_unlock',
            locationFieldId: '@locationAttribute.ControlId',
            cityFieldId: '@Html.IdFor(model => model.City)',
            countyFieldId: '@Html.IdFor(model => model.County)',
            streetFieldId: '@Html.IdFor(model => model.Address1)',
            zipFieldId: '@Html.IdFor(model => model.ZipPostalCode)',
            apiKey: '@apiKey',
            language: '@language',
            defaultCenter: '@defaultCenter'
        });
    </script>
}
