@model CustomerNavigationModel
@{
    var logoutUrl = Url.RouteUrl(NopRouteNames.Standard.LOGOUT);
    var logoutConfirm = JavaScriptEncoder.Default.Encode(T("Account.Logout.Confirm").Text);
    var yesText = JavaScriptEncoder.Default.Encode(T("Common.Yes").Text);
    var noText = JavaScriptEncoder.Default.Encode(T("Common.No").Text);
}
<section class="block block-account-navigation">
    <h2 class="title">
        @T("Account.Navigation")
    </h2>
    <div class="listbox">
        <ul class="list">
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.AccountNavigationBefore, additionalData = Model })
            @foreach (var item in Model.CustomerNavigationItems)
            {
                <li class="@item.ItemClass @(Model.SelectedTab == item.Tab ? "active" : "inactive")">
                    <a href="@Url.RouteUrl(item.RouteName)">@(item.Title)</a>
                </li>
            }
            @*logout is an action rather than a tab, so it is not one of the
                CustomerNavigationItems - it lives here now that the header no longer shows it*@
            <li class="customer-logout inactive">
                @*a themed jQuery UI dialog rather than window.confirm - the native box
                    ignores the theme, renders LTR, and browsers let the visitor mute it*@
                <a href="@logoutUrl" onclick="return displayConfirmation('@Html.Raw(logoutConfirm)', '@Html.Raw(yesText)', '@Html.Raw(noText)', function () { setLocation('@logoutUrl'); });">@T("Account.Logout")</a>
            </li>
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.AccountNavigationAfter, additionalData = Model })
        </ul>
    </div>
</section>
