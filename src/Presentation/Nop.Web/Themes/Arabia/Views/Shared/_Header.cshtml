@*
    Forked from the core header for one reason: the phone bar needs a control
    the core markup does not have — a button that expands the search field.

    A permanently open field ate two thirds of a 390px bar for something a
    shopper uses on a minority of visits. Collapsed it is a 44px glyph; tapped,
    it takes the bar over, the logo steps aside and the field takes focus. The
    core view is otherwise untouched, so every widget zone still fires.
*@
@inject Nop.Core.IWorkContext workContext
@inject Nop.Services.Catalog.ICategoryService categoryService
@inject Nop.Services.Localization.ILocalizationService localizationService
@using System.Text.Json

@{
    //Every page wears the teal top band on phones (brand.css). Home keeps the search pill open
    //under a greeting row that folds away on scroll (.ar-home-header); other pages collapse it to a glyph.
    var isHome = string.Equals(Context.Request.RouteValues["controller"]?.ToString(), "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(Context.Request.RouteValues["action"]?.ToString(), "Index", StringComparison.OrdinalIgnoreCase);
    var customer = isHome ? await workContext.GetCurrentCustomerAsync() : null;
    var firstName = customer != null && User.Identity?.IsAuthenticated == true ? customer.FirstName?.Trim() : null;
    //the search placeholder's rotating examples: the home page categories, by name, on every page
    //(the service call is cached, so this costs the header nothing)
    var placeholderNames = new List<string>();
    foreach (var category in await categoryService.GetAllCategoriesDisplayedOnHomepageAsync())
        placeholderNames.Add(await localizationService.GetLocalizedAsync(category, c => c.Name));
}
<header class="header@(isHome ? " ar-home-header" : "")">
    <a class="skip" href="#main">@T("Header.SkipNavigation.Text")</a>
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderBefore })
    @if (isHome)
    {
        <div class="ar-hello">
            <strong>@(string.IsNullOrEmpty(firstName) ? T("Mobile.Home.Hello") : T("Mobile.Home.HelloName", firstName))</strong>
            <span>@T("Mobile.Home.Tagline")</span>
        </div>
    }
    <div class="header-upper">
        <div class="header-selectors-wrapper">
            @*the currency selector is not offered in the storefront (Kinan, 2026-10-12); the wrapper stays for the
                layout and brand.css hides it while it is empty. Currencies and the admin side are untouched.*@
            @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderSelectors })
        </div>
        <div class="header-links-wrapper">
            @await Component.InvokeAsync(typeof(HeaderLinksViewComponent))
            @await Component.InvokeAsync(typeof(FlyoutShoppingCartViewComponent))
        </div>
    </div>
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderMiddle })
    <div class="header-lower">
        <div class="header-logo">
            @await Component.InvokeAsync(typeof(LogoViewComponent))
        </div>
        @*The company pages beside the logo. brand.css hides this copy below
            1001px, where the same partial rides in the category sheet.*@
        @{ await Html.RenderPartialAsync("_PageLinks"); }
        <div role="search" class="search-box store-search-box">
            @await Component.InvokeAsync(typeof(SearchBoxViewComponent))
        </div>
    </div>
    @*Phones and tablets only — brand.css hides it from 1001px up, where the bar
        has room for the field itself.*@
    <button class="mobile-search-toggle" type="button" aria-expanded="false" aria-controls="small-search-box-form" aria-label="@T("Search")">
        <svg class="mobile-search-icon mobile-search-icon--open" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="11" cy="11" r="7" />
            <path d="M20 20l-4.3-4.3" />
        </svg>
        <svg class="mobile-search-icon mobile-search-icon--close" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="m6 6 12 12M18 6 6 18" />
        </svg>
    </button>
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.HeaderAfter })
</header>

<script asp-location="Footer">
    //<details name="ar-nav"> already gives the browse dropdowns their keyboard,
    //their aria-expanded and "opening one closes the other". The one thing it
    //does not give is light dismiss, which is these six lines.
    document.addEventListener("click", function (event) {
        document.querySelectorAll(".header .header-pages__drop[open]").forEach(function (drop) {
            if (!drop.contains(event.target))
                drop.open = false;
        });
    });
</script>

<script asp-location="Footer">
    //The button owns one class on .header; brand.css does the rest, so nothing
    //here measures or positions anything.
    (function () {
        var header = document.querySelector('.header');
        var toggle = header && header.querySelector('.mobile-search-toggle');
        var field = header && header.querySelector('.search-box-text');
        if (!toggle || !field)
            return;

        //Submitting an empty field only ever produced a blocking alert from the
        //core script. A control that cannot do anything yet should say so.
        var submit = header.querySelector('.search-box-button');
        if (submit) {
            var syncSubmit = function () {
                submit.disabled = !field.value.trim();
            };
            field.addEventListener('input', syncSubmit);
            syncSubmit();
        }

        function setOpen(open) {
            header.classList.toggle('search-open', open);
            toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            if (open)
                field.focus();
            else
                field.blur();
        }

        toggle.addEventListener('click', function () {
            setOpen(!header.classList.contains('search-open'));
        });

        //Esc is the way out of a search field on every other app; and an empty
        //field the shopper has left alone should not keep the logo hidden.
        field.addEventListener('keydown', function (event) {
            if (event.key === 'Escape')
                setOpen(false);
        });

        field.addEventListener('blur', function () {
            if (!field.value)
                setTimeout(function () {
                    if (!header.contains(document.activeElement))
                        setOpen(false);
                }, 150);
        });

        //The placeholder names a category to look for, and changes every few seconds - a field that
        //says "search for lamps" invites a search where "search store" does not. The names are the home
        //page categories, printed by the server so every page rotates, not only the one with the tiles.
        {
            var names = @Html.Raw(JsonSerializer.Serialize(placeholderNames));
            var example = '@Html.Raw(JavaScriptEncoder.Default.Encode(T("Search.SearchBox.Example").Text))';
            if (names.length && example.indexOf('{0}') !== -1) {
                var at = Math.floor(Math.random() * names.length);
                var rotate = function () {
                    if (document.activeElement === field || field.value)
                        return;
                    field.classList.add('ar-placeholder-swap');
                    setTimeout(function () {
                        field.placeholder = example.replace('{0}', names[at++ % names.length]);
                        field.classList.remove('ar-placeholder-swap');
                    }, 220);
                };
                field.placeholder = example.replace('{0}', names[at++ % names.length]);
                setInterval(rotate, 3500);
            }
        }
    })();
</script>

<script asp-location="Footer">
    //Quick-return top bar, phones only: scrolling down hands the 64px back to
    //the catalogue, and any scroll up brings search straight back without a
    //trip to the top of the page. The bottom tab bar deliberately does NOT do
    //this - it is the primary navigation and carries the cart count, and a
    //shopper reaching for the cart should not have to fish for it.
    (function () {
        if (!window.matchMedia('(max-width: 1000px)').matches)
            return;

        var header = document.querySelector('.header');
        if (!header)
            return;

        //Below this the bar is still part of the page you are looking at, and
        //hiding it on the first flick reads as a glitch.
        var revealFrom = 120;
        //Ignore the jitter of a finger resting on the screen.
        var minDelta = 8;
        var last = window.scrollY;
        var ticking = false;
        //The home band does not leave: it folds to the search pill once the page
        //is scrolled (brand.css, .ar-header-compact) and opens again at the top.
        var home = header.classList.contains('ar-home-header');
        //how far the band slides up to leave only the search pill: the pill's offset
        //inside the band, less the band's top padding
        var searchBox = header.querySelector('.search-box');
        function measureFold() {
            if (!home || !searchBox)
                return;
            var pad = parseFloat(getComputedStyle(header).paddingTop) || 0;
            //both rectangles carry the band's transform, so the difference holds whether it is folded or not
            var fold = searchBox.getBoundingClientRect().top - header.getBoundingClientRect().top - pad;
            if (fold > 0)
                header.style.setProperty('--ar-fold', fold + 'px');
        }
        measureFold();
        window.addEventListener('resize', measureFold);

        window.addEventListener('scroll', function () {
            if (ticking)
                return;
            ticking = true;
            requestAnimationFrame(function () {
                var y = Math.max(window.scrollY, 0);
                if (home)
                    header.classList.toggle('ar-header-compact', y > 24);
                else if (Math.abs(y - last) > minDelta) {
                    header.classList.toggle('ar-header-hidden', y > last && y > revealFrom);
                    last = y;
                }
                ticking = false;
            });
        }, { passive: true });
        if (home && window.scrollY > 24)
            header.classList.add('ar-header-compact');

        //An open search field must never scroll away with the bar.
        header.addEventListener('focusin', function () {
            header.classList.remove('ar-header-hidden');
        });
    })();
</script>