@*
    TmTm mobile navigation shell — replaces the stacked category navbar that
    DefaultClean renders under the header on phones and tablets. That list was
    ~400px tall and, sitting under the three-band header, pushed the first
    product more than three screens down.

    In its place, a bottom tab bar with the four destinations a shopper actually
    uses - home, products, cart, account - thumb-reachable and always visible.
    "Products" goes to the all-categories page (the catalogue's front door); it
    used to open the category tree in a bottom sheet, one tap more to the same
    place.
*@
@using Nop.Core.Domain.Orders
@using Nop.Services.Orders

@inject IShoppingCartService shoppingCartService
@inject OrderSettings orderSettings
@inject Nop.Core.IStoreContext storeContext
@inject Nop.Core.IWorkContext workContext

@{
    var store = await storeContext.GetCurrentStoreAsync();
    var customer = await workContext.GetCurrentCustomerAsync();

    //mirrors CommonModelFactory: the flag spares the query for an empty cart,
    //which is the common case on a first visit
    var cartQuantity = 0;
    if (customer.HasShoppingCartItems)
    {
        cartQuantity = (await shoppingCartService.GetShoppingCartAsync(customer, ShoppingCartType.ShoppingCart, store.Id))
            .Sum(item => item.Quantity);
    }

    //Which tab is current is a question about the section of the store rather
    //than about one URL: /cart and every checkout step are both "cart", and an
    //order or a return request is still "account".
    var controller = Context.Request.RouteValues["controller"]?.ToString() ?? string.Empty;
    bool inSection(params string[] controllers) =>
        controllers.Any(name => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase));

    var homeActive = inSection("Home");
    var browseActive = inSection("Catalog", "Product");
    var cartActive = inSection("ShoppingCart", "Checkout");
    var action = Context.Request.RouteValues["action"]?.ToString() ?? string.Empty;
    bool onPage(string controllerName, params string[] actions) =>
        inSection(controllerName) && actions.Any(name => string.Equals(action, name, StringComparison.OrdinalIgnoreCase));
    var contactPage = onPage("Common", "ContactUs");
    //Notifications (a plugin page) and, for a signed-in customer, Contact us are account pages too
    var accountActive = inSection("Customer", "Order", "ReturnRequest", "CustomerNotifications")
        || (contactPage && User.Identity?.IsAuthenticated == true);
    //the store's other forms - the card sat on their submit buttons the same way
    var formPage = contactPage
        || onPage("Common", "ContactVendor")
        || onPage("Product", "ProductEmailAFriend", "ProductReviews")
        || onPage("Vendor", "ApplyVendor");
}

<nav class="mobile-tab-bar" aria-label="@T("Menu")">
    <a class="mobile-tab @(homeActive ? "active" : null)" href="@Url.RouteUrl(NopRouteNames.General.HOMEPAGE)" aria-current="@(homeActive ? "page" : null)">
        <span class="mobile-tab-icon-wrap">
            <svg class="mobile-tab-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M3 10.6 12 3.2l9 7.4" />
                <path d="M5.6 9.4V20a1 1 0 0 0 1 1h3.2v-5.6h4.4V21h3.2a1 1 0 0 0 1-1V9.4" />
            </svg>
        </span>
        <span class="mobile-tab-label">@T("Mobile.Nav.Home")</span>
    </a>
    <a class="mobile-tab @(browseActive ? "active" : null)" href="@Url.RouteUrl(NopRouteNames.General.CATEGORIES)" aria-current="@(browseActive ? "page" : null)">
        <span class="mobile-tab-icon-wrap">
            <svg class="mobile-tab-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3.4 13.4V3.4h10l7.2 7.2a2 2 0 0 1 0 2.8Z" />
                <circle cx="8" cy="8" r="1.4" />
            </svg>
        </span>
        <span class="mobile-tab-label">@T("Mobile.Nav.Products")</span>
    </a>
    <a class="mobile-tab @(cartActive ? "active" : null)" href="@Url.RouteUrl(NopRouteNames.General.CART)" aria-current="@(cartActive ? "page" : null)">
        <span class="mobile-tab-icon-wrap">
            <svg class="mobile-tab-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M5.6 8h12.8l.9 11.3a1.6 1.6 0 0 1-1.6 1.7H6.3a1.6 1.6 0 0 1-1.6-1.7Z" />
                <path d="M9 8V6.4a3 3 0 0 1 6 0V8" />
            </svg>
            @*Prints data-qty, not its own text: HeaderLinks keeps every .cart-qty
                on the page reduced to a bare number there, and an empty cart's
                badge is hidden on [data-qty="0"] with no script at all.*@
            <span class="mobile-tab-badge cart-qty" data-qty="@cartQuantity">@T("ShoppingCart.HeaderQuantity", cartQuantity)</span>
        </span>
        <span class="mobile-tab-label">@T("Mobile.Nav.Cart")</span>
    </a>
    <a class="mobile-tab @(accountActive ? "active" : null)" href="@Url.RouteUrl(NopRouteNames.General.CUSTOMER_INFO)" aria-current="@(accountActive ? "page" : null)">
        <span class="mobile-tab-icon-wrap">
            <svg class="mobile-tab-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="12" cy="8" r="3.8" />
                <path d="M4.6 20.6c0-3.9 3.3-6.1 7.4-6.1s7.4 2.2 7.4 6.1" />
            </svg>
        </span>
        <span class="mobile-tab-label">@T("Account.MyAccount")</span>
    </a>
</nav>
@*"Complete order" card, floating at the bottom of every page while the cart holds items - above
    the tab bar on phones, in the bottom corner on desktop (brand.css, off its own .cart-qty, which
    HeaderLinks keeps live after every AJAX add - so it appears with no reload). Not on the cart or
    checkout, which already are the goal. ✕ puts it away until the next visit or the next item
    added. Straight to checkout, unless the terms of service must be accepted on the cart page.*@
@*Nor in the account section (login, register, password recovery, my account, orders) or on
    any other form (contact us, email a friend): the shopper is filling it in, and the card sat on
    its submit button. It shows where the shopper browses: home, catalogue, product, search, info
    pages.*@
@if (!cartActive && !accountActive && !formPage)
{
    <div class="tm-cart-float">
        <a class="tm-cart-float-link" href="@(orderSettings.TermsOfServiceOnShoppingCartPage ? Url.RouteUrl(NopRouteNames.General.CART) : Url.RouteUrl(NopRouteNames.Standard.CHECKOUT))">
            <span class="cart-qty" data-qty="@cartQuantity">@T("ShoppingCart.HeaderQuantity", cartQuantity)</span>
            <span class="tm-cart-float-label">@T("Mobile.Nav.CompleteOrder")</span>
            <span class="tm-cart-float-total" hidden></span>
            <svg class="tm-cart-float-arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M9 5l7 7-7 7" />
            </svg>
        </a>
        <button type="button" class="tm-cart-float-close" aria-label="@T("Common.Close")"
                onclick="document.documentElement.classList.add('tm-cart-float-closed'); try { sessionStorage.setItem('tm-cart-float-closed', '1'); } catch (e) { }">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="m6 6 12 12M18 6 6 18" />
            </svg>
        </button>
    </div>
}
@*First page of a visit: the card bounces once, so a cart left from last time gets noticed
    (brand.css only animates it when it is showing). A card put away with ✕ stays away for the
    visit - until an item is added, when the reminder is relevant again: the count going up (its
    data-qty, kept live by HeaderLinks) brings it back. Storage can throw (blocked site data) -
    then there is simply no bounce, and ✕ lasts for the page.*@
<script>
    try {
        if (!sessionStorage.getItem('tm-cart-pill-seen')) {
            sessionStorage.setItem('tm-cart-pill-seen', '1');
            document.documentElement.classList.add('tm-cart-pill-bounce');
        }
        if (sessionStorage.getItem('tm-cart-float-closed'))
            document.documentElement.classList.add('tm-cart-float-closed');
    } catch (e) { }

    (function () {
        var card = document.querySelector('.tm-cart-float');
        var qty = card && card.querySelector('.cart-qty');
        if (!qty) return;
        var total = card.querySelector('.tm-cart-float-total');

        //the total is the mini cart's subtotal: the header renders it on every page and AjaxCart swaps
        //in a fresh #flyout-cart after each add, so the card reads it rather than asking the server again
        function syncTotal() {
            var subtotal = document.querySelector('#flyout-cart .totals strong');
            var text = subtotal ? subtotal.textContent.trim() : '';
            total.textContent = text;
            total.hidden = !text;
        }

        var last = parseInt(qty.getAttribute('data-qty'), 10) || 0;
        new MutationObserver(function () {
            var now = parseInt(qty.getAttribute('data-qty'), 10) || 0;
            if (now > last) {
                document.documentElement.classList.remove('tm-cart-float-closed');
                try { sessionStorage.removeItem('tm-cart-float-closed'); } catch (e) { }
                //an item went in: the card gives a small hop. The class stays on
                //until the next add - taking it off when the hop ends hands the
                //card back its slide-in (and first-visit bounce), which then replay
                card.classList.remove('tm-cart-float-bump');
                void card.offsetWidth;
                card.classList.add('tm-cart-float-bump');
            }
            last = now;
        }).observe(qty, { attributes: true, attributeFilter: ['data-qty'] });

        function watchFlyout() {
            syncTotal();
            var flyout = document.querySelector('#flyout-cart');
            //replaceWith swaps the node itself, so watch its parent
            if (flyout && flyout.parentNode)
                new MutationObserver(syncTotal).observe(flyout.parentNode, { childList: true, subtree: true });
        }
        if (document.readyState === 'loading')
            document.addEventListener('DOMContentLoaded', watchFlyout);
        else
            watchFlyout();
    })();
</script>