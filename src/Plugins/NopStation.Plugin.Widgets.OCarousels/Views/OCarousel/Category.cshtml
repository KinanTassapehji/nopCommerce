@model OCarouselModel

@if (Model.Categories.Count > 0)
{
    <div class="owl-carousel ocarousel @Model.CustomCssClass" id="ocarousel-@(Model.Id)">
        @foreach (var categoryModel in Model.Categories)
        {
            <div class="ocarousel-item">
                <a href="@(await NopUrl.RouteGenericUrlAsync<Category>(new { sename = categoryModel.SeName }))" title="@categoryModel.PictureModel.Title">
                    <img alt="@categoryModel.PictureModel.AlternateText" src="@categoryModel.PictureModel.ImageUrl" title="@categoryModel.PictureModel.Title" />
                </a>
                <div class="category-name">
                    <a href="@(await NopUrl.RouteGenericUrlAsync<Category>(new {SeName = categoryModel.SeName}))">@categoryModel.Name</a>
                </div>
            </div>
        }
    </div>

    <script asp-exclude-from-bundle="true" asp-location="Footer">
        $(document).ready(function () {
            $('#ocarousel-@(Model.Id)').owlCarousel({
                //ponytail: dots only, everywhere. Model.Nav (the admin "Nav" checkbox) is
                //deliberately ignored - restore it here if the arrows are ever wanted back.
                nav: false,
                @*step a whole row at a time so the arrows and the dots, which are page-based,
                    stay in agreement*@
                slideBy: 'page',
                loop: @Model.Loop.ToString().ToLower(),
                dots: true,
                margin: 10,
                autoplay: @Model.AutoPlay.ToString().ToLower(),
                rtl: @Model.Rtl.ToString().ToLower(),
                autoplayTimeout: @Model.AutoPlayTimeout,
                autoplayHoverPause: @Model.AutoPlayHoverPause.ToString().ToLower(),
                lazyLoad: @Model.LazyLoad.ToString().ToLower(),
                lazyLoadEager: @Model.LazyLoadEager,
                center: @Model.Center.ToString().ToLower(),
                startPosition: @Model.StartPosition,
                responsive: {
                    0: {
                        items: 1
                    },
                    576: {
                        items: 1
                    },
                    768: {
                        items: 2
                    },
                    992: {
                        items: 4
                    },
                    1200: {
                        items: 4
                    },
                    1500: {
                        items: 4
                    }
                }
            });
        })
    </script>
}

@NopHtml.GenerateInlineScripts(ResourceLocation.Footer)