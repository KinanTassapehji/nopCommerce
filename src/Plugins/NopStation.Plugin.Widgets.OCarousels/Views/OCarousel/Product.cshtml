@model OCarouselModel

@if (Model.Products.Count > 0)
{
    <div class="owl-carousel ocarousel @Model.CustomCssClass" id="ocarousel-@(Model.Id)">
        @foreach (var item in Model.Products)
        {
            <div class="item-box">
                @await Html.PartialAsync("_ProductBox", item)
            </div>
        }
    </div>

    <script asp-exclude-from-bundle="true" asp-location="Footer">
        $(document).ready(function () {
            $('#ocarousel-@(Model.Id)').owlCarousel({
                //ponytail: no arrows and no dots, so the rail matches the theme's own scroll
                //rails (deals, featured, bestsellers). Model.Nav (the admin "Nav" checkbox) is
                //deliberately ignored - restore it here if arrows are ever wanted back.
                nav: false,
                slideBy: 'page',
                loop: @Model.Loop.ToString().ToLower(),
                dots: false,
                margin: 16,
                autoplay: @Model.AutoPlay.ToString().ToLower(),
                rtl: @Model.Rtl.ToString().ToLower(),
                autoplayTimeout: @Model.AutoPlayTimeout,
                autoplayHoverPause: @Model.AutoPlayHoverPause.ToString().ToLower(),
                lazyLoad: @Model.LazyLoad.ToString().ToLower(),
                lazyLoadEager: @Model.LazyLoadEager,
                center: @Model.Center.ToString().ToLower(),
                startPosition: @Model.StartPosition,
                //five to a desktop row and a 16px gap: the same card the deals, featured and
                //bestseller rails use, so one band is not a size of its own
                responsive: {
                    @*two cards to a phone row, the same count as every grid on the site: one card per
                        swipe was a screen per product*@
                    0: {
                        items: 2
                    },
                    576: {
                        items: 2
                    },
                    768: {
                        items: 3
                    },
                    992: {
                        items: 5
                    },
                    1200: {
                        items: 5
                    },
                    1500: {
                        items: 5
                    }
                }
            });
        });
    </script>
}

@NopHtml.GenerateInlineScripts(ResourceLocation.Footer)