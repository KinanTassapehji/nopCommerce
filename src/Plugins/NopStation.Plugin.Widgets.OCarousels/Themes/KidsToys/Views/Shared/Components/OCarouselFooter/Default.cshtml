@inject Nop.Core.IWorkContext workContext
@using Nop.Web.Framework.Themes
@inject IThemeContext themeContext

@{
    var supportRtl = (await workContext.GetWorkingLanguageAsync()).Rtl;
    var themeName = await themeContext.GetWorkingThemeNameAsync();
    NopHtml.AppendScriptParts(ResourceLocation.Footer, $"~/Plugins/NopStation.Plugin.Widgets.OCarousels/Themes/{themeName}/Contents/script/nopstation.carousel.js");
    NopHtml.AppendCssFileParts($"~/Plugins/NopStation.Plugin.Widgets.OCarousels/Themes/{themeName}/Contents/css/styles.css");

    if (supportRtl)
    {
        NopHtml.AppendCssFileParts($"~/Plugins/NopStation.Plugin.Widgets.OCarousels/Themes/{themeName}/Contents/css/rtl/owl.theme.green.min.css");
        NopHtml.AppendCssFileParts($"~/Plugins/NopStation.Plugin.Widgets.OCarousels/Themes/{themeName}/Contents/css/rtl/owl.carousel.css");
    }
    else
    {
        NopHtml.AppendCssFileParts($"~/Plugins/NopStation.Plugin.Widgets.OCarousels/Themes/{themeName}/Contents/css/owl.theme.green.min.css");
        NopHtml.AppendCssFileParts($"~/Plugins/NopStation.Plugin.Widgets.OCarousels/Themes/{themeName}/Contents/css/owl.carousel.css");
    }
}

<script asp-location="Footer">
    var carouseldata = {};
    carouseldata.CarouselFailure = '@T("NopStation.Plugin.Widgets.OCarousels.LoadingFailed")';

    $(document).ready(function () {
        Carousel.init('@Url.RouteUrl("OCarousel")', '.carousel-container', '.carousel-container .loader', carouseldata);
    });
</script>