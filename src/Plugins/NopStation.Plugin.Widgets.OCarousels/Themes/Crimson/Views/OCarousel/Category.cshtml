@model OCarouselModel
@using Nop.Core.Domain.Catalog

@if (Model.Categories.Count > 0)
{
    <div class="category-slider category-add manufacturers-content py-3 py-sm-5 mb-0 mb-lg-5" style="background-image: url('@Model.BackgroundPictureUrl');">
        <div class="container pb-5 wow fadeInUp">
            <div class="row">
                <div class="col-md-12">
                    <div class="owl-carousel owl-theme ocarousel @Model.CustomCssClass" id="ocarousel-@(Model.Id)">
                        @foreach (var categoryModel in Model.Categories)
                        {
                            <div class="item m-3">
                                <a class="d-block" href="@(await NopUrl.RouteGenericUrlAsync<Category>(new { SeName = categoryModel.SeName }))" title="@categoryModel.PictureModel.Title">
                                    <img alt="@categoryModel.PictureModel.AlternateText" src="@categoryModel.PictureModel.ImageUrl" title="@categoryModel.PictureModel.Title" />
                                    <div class="category-add-text p-3 text-center text-uppercase"> @categoryModel.Name <i class="icon-right-arrow31"></i>  </div>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            $('#ocarousel-@(Model.Id)').owlCarousel({
                nav: @Model.Nav.ToString().ToLower(),
                loop: @Model.Loop.ToString().ToLower(),
                dots: true,
                margin: 10,
                autoplay: @Model.AutoPlay.ToString().ToLower(),
                rtl: @Model.Rtl.ToString().ToLower(),
                autoplayTimeout: @Model.AutoPlayTimeout,
                autoplayHoverPause: @Model.AutoPlayHoverPause.ToString().ToLower(),
                lazyLoad: @Model.LazyLoad.ToString().ToLower(),
                lazyLoadEager: @Model.LazyLoadEager,
                center: @Model.Center.ToString().ToLower(),
                startPosition: @Model.StartPosition,
                responsive: {
                    0: {
                        items: 1
                    },
                    576: {
                        items: 2
                    },
                    768: {
                        items: 2
                    },
                    992: {
                        items: 3
                    },
                    1200: {
                        items: 3
                    },
                    1500: {
                        items: 3
                    }
                }
            });
        })
    </script>
}

@NopHtml.GenerateInlineScripts(ResourceLocation.Footer)