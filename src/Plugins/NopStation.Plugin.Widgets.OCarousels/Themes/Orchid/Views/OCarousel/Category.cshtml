@model OCarouselModel

@if (Model.Categories.Count > 0)
{
    if (Model.ShowBackgroundPicture)
    {
        <div class="ocarousel-background" style="background:url('@Model.BackgroundPictureUrl') no-repeat center; background-size: cover;">
            <div class="ocarousel-grid category-carousel">
                @if (Model.DisplayTitle)
                {
                    <div class="title">
                        <i class="icon-logo-icon-left"></i>
                        <strong>@Model.Title</strong>
                        <i class="icon-logo-icon-right"></i>
                    </div>
                }

                <div class="owl-carousel ocarousel @Model.CustomCssClass" id="ocarousel-@(Model.Id)">
                    @foreach (var categoryModel in Model.Categories)
                    {
                        <div class="ocarousel-item">
                            <a class="category-img" href="@(await NopUrl.RouteGenericUrlAsync<Category>(new { SeName = categoryModel.SeName }))" title="@categoryModel.PictureModel.Title">
                                <img alt="@categoryModel.PictureModel.AlternateText" src="@categoryModel.PictureModel.ImageUrl" title="@categoryModel.PictureModel.Title" />
                            </a>
                            <div class="category-content">
                                <div class="category-name">
                                    <a href="@(await NopUrl.RouteGenericUrlAsync<Category>(new { SeName = categoryModel.SeName }))">@categoryModel.Name</a>
                                </div>
                                <a class="shop-button" href="@(await NopUrl.RouteGenericUrlAsync<Category>(new { SeName = categoryModel.SeName }))"><i class="icon-cart-icon"></i>Shop Now!</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="ocarousel-grid category-carousel">
            @if (Model.DisplayTitle)
            {
                <div class="title">
                    <i class="icon-logo-icon-left"></i>
                    <strong>@Model.Title</strong>
                    <i class="icon-logo-icon-right"></i>
                </div>
            }

            <div class="owl-carousel ocarousel @Model.CustomCssClass" id="ocarousel-@(Model.Id)">
                @foreach (var categoryModel in Model.Categories)
                {
                    <div class="ocarousel-item">
                        <a class="category-img" href="@(await NopUrl.RouteGenericUrlAsync<Category>(new { SeName = categoryModel.SeName }))" title="@categoryModel.PictureModel.Title">
                            <img alt="@categoryModel.PictureModel.AlternateText" src="@categoryModel.PictureModel.ImageUrl" title="@categoryModel.PictureModel.Title" />
                        </a>
                        <div class="category-content">
                            <div class="category-name">
                                <a href="@(await NopUrl.RouteGenericUrlAsync<Category>(new { SeName = categoryModel.SeName }))">@categoryModel.Name</a>
                            </div>
                            <a class="shop-button" href="@(await NopUrl.RouteGenericUrlAsync<Category>(new { SeName = categoryModel.SeName }))"><i class="icon-cart-icon"></i>Shop Now!</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <script>
        $(document).ready(function () {
            $('#ocarousel-@(Model.Id)').owlCarousel({
                nav: @Model.Nav.ToString().ToLowerInvariant(),
                loop: @Model.Loop.ToString().ToLowerInvariant(),
                dots: true,
                margin: 30,
                autoplay: false,
                rtl: false,
                autoplayTimeout: @Model.AutoPlayTimeout,
                autoplayHoverPause: @Model.AutoPlayHoverPause.ToString().ToLowerInvariant(),
                lazyLoad: @Model.LazyLoad.ToString().ToLowerInvariant(),
                lazyLoadEager: @Model.LazyLoadEager,
                center: @Model.Center.ToString().ToLowerInvariant(),
                startPosition: @Model.StartPosition,
                items: 1
            });
            $(".owl-next").html("<i class='icon-right-arrow-icon'></i>");
            $(".owl-prev").html("<i class='icon-left-arrow-icon'></i>");
        });
    </script>
}
