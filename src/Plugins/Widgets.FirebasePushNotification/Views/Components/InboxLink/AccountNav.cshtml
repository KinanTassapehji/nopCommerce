@model int
@using Widgets.FirebasePushNotification.Infrastructure
@{
    NopHtml.AppendCssFileParts("~/Plugins/Widgets.FirebasePushNotification/Content/notifications.css");
    var active = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "CustomerNotifications", StringComparison.OrdinalIgnoreCase);
}
<li class="customer-notifications @(active ? "active" : "inactive")">
    <a href="@Url.RouteUrl(RouteProvider.NotificationsRouteName)">
        @T("Plugins.Widgets.FirebasePushNotification.Inbox.Title")
        @if (Model > 0)
        {
            <span class="tm-inbox-badge tm-inbox-badge--inline">@(Model > 99 ? "99+" : Model.ToString())</span>
        }
    </a>
</li>
