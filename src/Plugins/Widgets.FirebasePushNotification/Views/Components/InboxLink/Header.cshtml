@model int
@using Widgets.FirebasePushNotification.Infrastructure
@{
    NopHtml.AppendCssFileParts("~/Plugins/Widgets.FirebasePushNotification/Content/notifications.css");
}
<li class="tm-inbox-bell-item">
    <a href="@Url.RouteUrl(RouteProvider.NotificationsRouteName)" class="tm-inbox-bell" aria-label="@T("Plugins.Widgets.FirebasePushNotification.Inbox.Title")@(Model > 0 ? $" ({Model})" : null)">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
            <path d="M10.3 21a1.9 1.9 0 0 0 3.4 0" />
        </svg>
        @if (Model > 0)
        {
            <span class="tm-inbox-badge">@(Model > 99 ? "99+" : Model.ToString())</span>
        }
    </a>
</li>
