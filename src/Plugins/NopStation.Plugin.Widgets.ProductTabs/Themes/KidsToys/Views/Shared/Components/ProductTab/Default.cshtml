@model IEnumerable<ProductTabModel>
@using NopStation.Plugin.Widgets.ProductTabs.Models

@if (Model.Any())
{
    foreach (var productTab in Model)
    {
        var items = productTab.Items.Where(p => p.Products.Any());
        <div class="product-tab-container container">
            @if (productTab.DisplayTitle)
            {
                <div class="d-none title">
                    <strong>@productTab.Title</strong>
                </div>
            }

            <div class="product-tab-body ns-product-tab">
                <div class="d-none product-tab-picture">
                    <a href="@productTab.CustomUrl">
                        <img src="@productTab.Picture.ImageUrl" />
                        @if (productTab.DisplayTitle)
                        {
                            <strong>@productTab.Title</strong>
                        }
                    </a>
                </div>
                <div class="product-tab-item-wrapper">
                    <div class="container">
                        <div class="row align-items-center product-tab-item-header">
                            @if (productTab.DisplayTitle)
                            {
                                <div class="col-12 col-lg-3 col-xl-2">
                                    <div class="d-none py-3 py-lg-0 product-tab-title">
                                        @productTab.Title
                                    </div>
                                </div>

                                <div class="owl-nav">
                                    <button type="button" role="presentation" class="owl-prev title-nav-previous"><span aria-label="Previous">‹</span></button>
                                    <button type="button" role="presentation" class="owl-next title-nav-next"><span aria-label="Next">›</span></button>
                                </div>
                                <script asp-location="Footer">
                                    $('.title-nav-previous').click(function () {
                                        var parentTabContainer = $(this).parents(".product-tab-body");
                                        var activeTab = parentTabContainer.find(".ui-widget-content:not(.owl-hidden)");
                                        var carouselPrevious = activeTab.find(".owl-prev");
                                        carouselPrevious.click();
                                    })

                                    $('.title-nav-next').click(function () {
                                        var parentTabContainer = $(this).parents(".product-tab-body");
                                        var activeTab = parentTabContainer.find(".ui-widget-content:not(.owl-hidden)");
                                        var carouselNext = activeTab.find(".owl-next");
                                        carouselNext.click();
                                    })
                                </script>
                                <div class="col-12 col-lg-8 col-xl-9">
                                    <ul class="d-none nav nav-tabs text-uppercase">
                                        @foreach (var item in items)
                                        {
                                            <li><a href="#product-tab-@item.Id">@item.Name</a></li>
                                        }
                                    </ul>
                                </div>
                                <div class="col-3 col-lg-1"></div>
                            }
                            else
                            {
                                <div class="col-11">
                                    <ul class="nav nav-tabs text-uppercase">
                                        @foreach (var item in items)
                                        {
                                            <li><a href="#product-tab-@item.Id">@item.Name</a></li>
                                        }
                                    </ul>
                                </div>
                                <div class="col-1"></div>
                            }
                        </div>
                    </div>
                    @foreach (var item in items)
                    {
                        <div class="product-tab-items">
                            <div class="owl-carousel owl-theme" id="product-tab-@item.Id">
                                @for (int productCounter = 0; productCounter < item.Products.Count;)
                                {
                                    <div class="product-tab-item item-box">
                                        @for (int i = 0; i < 2 && productCounter < item.Products.Count; i++)
                                        {
                                            @await Html.PartialAsync("_ProductBox", item.Products[productCounter])
                                            productCounter++;
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <script asp-location="Footer">
                                $(document).ready(function () {
                                    $('#product-tab-@item.Id').owlCarousel({
                                        nav: @productTab.Nav.ToString().ToLower(),
                                        loop: @productTab.Loop.ToString().ToLower(),
                                        dots: true,
                                        margin: @productTab.Margin,
                                        autoplay: @productTab.AutoPlay.ToString().ToLower(),
                                        rtl: @productTab.RTL.ToString().ToLower(),
                                        autoplayTimeout: @productTab.AutoPlayTimeout,
                                        autoplayHoverPause: @productTab.AutoPlayHoverPause.ToString().ToLower(),
                                        lazyLoad: @productTab.LazyLoad.ToString().ToLower(),
                                        lazyLoadEager: @productTab.LazyLoadEager,
                                        center: @productTab.Center.ToString().ToLower(),
                                        startPosition: @productTab.StartPosition,
                                        responsive: {
                                            0: {
                                                items: 1
                                            },
                                            768: {
                                                items: 2
                                            },
                                            992: {
                                                items: 3
                                            },
                                            1100: {
                                                items: 4
                                            },
                                            1300: {
                                                items: 5
                                            }
                                        }
                                    });
                                });
                        </script>
                    }
                </div>
            </div>
        </div>
    }
}
@NopHtml.GenerateInlineScripts(ResourceLocation.Footer)