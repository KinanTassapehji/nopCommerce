<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <SolutionDir Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)..\..\</SolutionDir>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NopStation.Plugin.Misc.Core</AssemblyName>
    <RootNamespace>NopStation.Plugin.Misc.Core</RootNamespace>
    <OutputPath>$(SolutionDir)\Presentation\Nop.Web\Plugins\NopStation.Core</OutputPath>
    <OutDir>$(OutputPath)</OutDir>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0618;CS1998</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="**\*" Exclude="bin\**;obj\**;**\*.cs;**\*.csproj;**\*.user">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)\Plugins\NopStation.Plugin.Misc.Actions\NopStation.Plugin.Misc.Actions.csproj">
      <Private>true</Private>
    </ProjectReference>
    <ProjectReference Include="$(SolutionDir)\Presentation\Nop.Web\Nop.Web.csproj" />
    <ClearPluginAssemblies Include="$(SolutionDir)\Build\ClearPluginAssemblies.proj" />
  </ItemGroup>

  <!-- CopyLocalLockFileAssemblies, which this plugin needs for its own NuGet packages, also copies
    the RID-specific runtimes\ tree of the whole dependency graph - SkiaSharp, HarfBuzz, the SqlClient
    SNI natives and so on, for every one of the 19 runtime identifiers. Nop.Web has an identical copy
    in the application base directory and that is where the host resolves native assets from, so the
    plugin copy is dead weight. -->
  <Target Name="NopRemoveRuntimeAssets" AfterTargets="ResolveReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="$([System.String]::Copy('%(ReferenceCopyLocalPaths.DestinationSubDirectory)').StartsWith('runtimes'))" />
    </ItemGroup>
  </Target>

  <Target Name="NopTarget" AfterTargets="Build">
    <MSBuild Projects="@(ClearPluginAssemblies)" Properties="PluginPath=$(OutDir)" Targets="NopClear" />
  </Target>

</Project>