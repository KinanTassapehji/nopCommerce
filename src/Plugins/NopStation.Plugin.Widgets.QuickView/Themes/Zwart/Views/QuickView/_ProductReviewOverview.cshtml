@model ProductReviewOverviewModel
@using System.Globalization
@using Nop.Core.Domain.Catalog
@inject Nop.Services.Seo.IUrlRecordService UrlRecordService

@{
    var ratingPercent = 0;
    if (Model.TotalReviews != 0)
    {
        ratingPercent = ((Model.RatingSum * 100) / Model.TotalReviews) / 5;
    }

    var productSeName = await UrlRecordService.GetSeNameAsync(Model.ProductId, nameof(Product));
    var productUrl = await NopUrl.RouteGenericUrlAsync<Product>(new { SeName = productSeName });
    var reviewsUrl = $"{productUrl}#productreviews";
    var addReviewUrl = $"{productUrl}#addreview";

}
@if (true)
{
    <div class="product-reviews-overview" @if (Model.TotalReviews > 0) { <text>itemprop="aggregateRating" itemscope itemtype="http://schema.org/AggregateRating"</text>}>
        <div class="product-review-box">
            <div class="rating">
                <div style="width: @(ratingPercent)%">
                </div>
            </div>
        </div>

        @if (Model.TotalReviews > 0)
        {
            <div class="product-review-links">
                    <a href="@reviewsUrl">@Model.TotalReviews
                        @T("Reviews.Overview.Reviews")
                    </a> <span class="separator">|</span> <a href="@addReviewUrl">@T("Reviews.Overview.AddNew")</a>

            </div>
            @*hidden microdata info*@
            var ratingValue = ratingPercent / (decimal)20;
            <span itemprop="ratingValue" style="display: none;">@ratingValue.ToString("0.0", new CultureInfo("en-US"))</span>
            <span itemprop="reviewCount" style="display: none;">@Model.TotalReviews</span>
        }
        else
        {
            <div class="product-no-reviews">
                    <a href="@addReviewUrl">@T("Reviews.Overview.First")</a>
            </div>
        }
    </div>
}