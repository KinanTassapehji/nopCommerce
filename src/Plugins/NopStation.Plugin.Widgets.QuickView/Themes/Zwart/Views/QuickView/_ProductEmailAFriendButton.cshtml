@model ProductDetailsModel
@if (Model.EmailAFriendEnabled)
{
    <div class="email-a-friend">
        <button title="@T("Products.EmailAFriend")" type="button" class="button-2 email-a-friend-button" onclick="setLocation('@Url.RouteUrl(NopRouteNames.Standard.PRODUCT_EMAIL_FRIEND, new { productId = Model.Id })')">
            <i class="fa fa-envelope-o pr-2" aria-hidden="true"></i>@T("Products.EmailAFriend")
        </button>
    </div>
}
