@model ProductReviewOverviewModel
@using System.Globalization
@{
    var ratingPercent = 0;
    var noReviews = Model.TotalReviews == 0;
    if (!noReviews)
    {
        ratingPercent = ((Model.RatingSum * 100) / Model.TotalReviews) / 5;
    }
    var reviewsUrl = Url.RouteUrl("ProductReviews", new { productId = Model.ProductId });
}

@if (true)
{
    <div class="product-reviews-overview" @(Model.TotalReviews > 0 ? Html.Raw("itemprop=\"aggregateRating\" itemscope itemtype=\"http://schema.org/AggregateRating\"") : null)>
        <div class="product-review-box">
            <div class="rating">
                <div style="width: @(ratingPercent)%">
                </div>
            </div>
        </div>

        <div class="product-review-links">
            @if (Model.TotalReviews > 0)
            {
                <a class="beautyShop-primary-color-hover" href="@reviewsUrl">
                    @Model.TotalReviews
                    @T("Reviews.Overview.Reviews")
                </a>
            }

            @if (Model.CanAddNewReview && Model.CanCurrentCustomerLeaveReview)
            {
                if (Model.TotalReviews > 0)
                {
                    <span class="separator">|</span>
                }
                <a href="@reviewsUrl" class="beautyShop-primary-color-hover add-review @(noReviews ? "product-no-reviews" : string.Empty)">@T(noReviews ? "Reviews.Overview.First" : "Reviews.Overview.AddNew")</a>
            }
        </div>

        @if (Model.TotalReviews > 0)
        {
            var ratingValue = ratingPercent / (decimal)20;
            <span itemprop="ratingValue" style="display: none;">@ratingValue.ToString("0.0", new CultureInfo("en-US"))</span>
            <span itemprop="reviewCount" style="display: none;">@Model.TotalReviews</span>
        }
    </div>
}