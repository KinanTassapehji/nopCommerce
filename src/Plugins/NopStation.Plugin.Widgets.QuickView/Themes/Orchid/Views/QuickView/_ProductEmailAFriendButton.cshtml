@model ProductDetailsModel
@if (Model.EmailAFriendEnabled)
{
<div class="email-a-friend">
    <button type="button" class="button-2 email-a-friend-button"  value="@T("Products.EmailAFriend")" onclick="setLocation('@Url.RouteUrl(NopRouteNames.Standard.PRODUCT_EMAIL_FRIEND, new { productId = Model.Id })')" >
        <i class="icon-email-icon"></i>
    </button>
</div>
}
