@model PublicModel
@using Nop.Core;
@using Nop.Core.Domain.Orders;
@using Nop.Services.Cms;
@using Nop.Services.Configuration;
@using Nop.Web.Framework.UI
@using Nop.Services.Plugins
@using NopStation.Plugin.Widgets.QuickView;
@inject Nop.Core.IWorkContext workContext
@inject IPluginService pluginService
@inject IStoreContext storeContext
@inject QuickViewSettings quickViewSettings
@inject ISettingService settingService
@{
    NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/Plugins/NopStation.Plugin.Widgets.QuickView/Themes/Kingdom/Content/js/quickview.js");
    NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/Plugins/NopStation.Plugin.Widgets.QuickView/Contents/js/jquery.fullscreen-popup.min.js");

    NopHtml.AppendCssFileParts("~/Plugins/NopStation.Plugin.Widgets.QuickView/Contents/css/styles.css", string.Empty);
    var supportRtl = (await workContext.GetWorkingLanguageAsync()).Rtl;
    if (supportRtl)
    {
        NopHtml.AppendCssFileParts("~/Plugins/NopStation.Plugin.Widgets.QuickView/Themes/Kingdom/Content/css/style.rtl.css", string.Empty);
    }
    else
    {
        NopHtml.AppendCssFileParts("~/Plugins/NopStation.Plugin.Widgets.QuickView/Themes/Kingdom/Content/css/style.css", string.Empty);
    }

    var qvlbl = T("NopStation.QuickView.Button.QuickView").Text;
    @* register CSS and JS *@
    <link rel="stylesheet" href="~/lib_npm/filepond/filepond.min.css" />
    <link rel="stylesheet" href="~/lib_npm/filepond-plugin-get-file/filepond-plugin-get-file.min.css" />
    <script asp-exclude-from-bundle="true" src="~/lib_npm/filepond/filepond.min.js" asp-location="Footer"></script>
    <script asp-exclude-from-bundle="true" src="~/lib_npm/filepond-plugin-file-validate-type/filepond-plugin-file-validate-type.min.js" asp-location="Footer"></script>
    <script asp-exclude-from-bundle="true" src="~/lib_npm/filepond-plugin-get-file/filepond-plugin-get-file.min.js" asp-location="Footer"></script>
    var ajaxCartPlugin = await pluginService.GetPluginDescriptorBySystemNameAsync<IWidgetPlugin>("NopStation.Plugin.Widgets.AjaxCart",
                   LoadPluginsMode.InstalledOnly, (await workContext.GetCurrentCustomerAsync()), (await storeContext.GetCurrentStoreAsync()).Id);
    var store = await storeContext.GetCurrentStoreAsync();
    var ajaxCartInstalled = false;
    if (ajaxCartPlugin != null)
    {
        if (ajaxCartPlugin.Installed)
        {
            ajaxCartInstalled = true;
            var showSuccessFailNotification = await settingService.GetSettingByKeyAsync<bool>("AjaxCartSettings.EnableSuccessFailNotificationOnAddToCart", storeId: store.Id, loadSharedValueIfNotFound: true);
            ajaxCartInstalled = showSuccessFailNotification;
        }
    }
}

<div class="qv-modal" id="qv-modal">
    <div class="loader">
        <div class="lds-facebook"><div></div><div></div><div></div></div>
    </div>
    <div class="qv-details"></div>
</div>
<button type="button" class="qvclick-button"></button>

<script asp-location="Footer">
    var quickviewdata = {};

    quickviewdata.QuickViewFailure = '@T("NopStation.QuickView.Failed")';

    $(document).ready(function () {
        QuickView.init(@Model.PictureZoomEnabled.ToString().ToLower(), '@Url.RouteUrl("QuickViewProductDetails")', '#qv-modal', '.qvclick-button', '.qv-modal .loader', quickviewdata);
        QuickView.render_quickview_button('@qvlbl');
    });

    $(document).on('ajaxSuccess', function () {
        QuickView.init(@Model.PictureZoomEnabled.ToString().ToLower(), '@Url.RouteUrl("QuickViewProductDetails")', '#qv-modal', '.qvclick-button', '.qv-modal .loader', quickviewdata);
        QuickView.render_quickview_button('@qvlbl');
    });

    $(window).on('resize', function () {
        if (/Android|webOS|iPhone|iPad|Mac|Macintosh|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)) {
            $('.quick-view-btn').hide();
        }
    });

</script>