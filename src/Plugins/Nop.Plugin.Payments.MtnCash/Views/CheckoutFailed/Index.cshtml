@using Nop.Web.Framework.UI
@inject INopHtmlHelper NopHtml
@model int

@{
    Layout = "~/Views/Shared/_Root.cshtml";
    NopHtml.AddTitleParts(T("Plugins.Payments.MtnCash.Ui.Failed").Text);
}

<div class="page checkout-page">
    <div class="page-title">
        <h1>@T("Plugins.Payments.MtnCash.Ui.Failed")</h1>
    </div>

    <div class="page-body checkout-data">
        <div class="section">
            <p>
                @T("Plugins.Payments.MtnCash.Ui.FailedText")
            </p>

            <div class="buttons">
                <a href="@Url.RouteUrl("OrderDetails", new { orderId = Model })"
                   class="button-1 checkout-button">
                    @T("Plugins.Payments.MtnCash.Ui.RetryPayment")
                </a>

                <a href="@Url.RouteUrl("CustomerOrders")"
                   class="button-2 checkout-button">
                    @T("Plugins.Payments.MtnCash.Ui.MyOrders")
                </a>
            </div>
        </div>
    </div>
</div>
