@using Nop.Web.Framework.UI
@inject INopHtmlHelper NopHtml
@model int

@{
    Layout = "~/Views/Shared/_Root.cshtml";
    NopHtml.AddTitleParts("Payment Failed");
}

<div class="page checkout-page">
    <div class="page-title">
        <h1>Payment Failed</h1>
    </div>

    <div class="page-body checkout-data">
        <div class="section">
            <p>
                We couldn't complete your Syriatel payment.<br />
                No charges were made. You can retry payment from your order details.
            </p>

            <div class="buttons">
                <a href="@Url.RouteUrl("OrderDetails", new { orderId = Model })"
                   class="button-1 checkout-button">
                    Retry Payment
                </a>

                <a href="@Url.RouteUrl("CustomerOrders")"
                   class="button-2 checkout-button">
                    My Orders
                </a>
            </div>
        </div>
    </div>
</div>
