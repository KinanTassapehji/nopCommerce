@model Nop.Plugin.Payments.Syriatel.Models.ConfirmPaymentModel
@{
    Layout = "_ColumnsOne";
}

<div class="page checkout-page">
    <div class="page-title">
        <h1>@T("Plugins.Payments.Syriatel.Ui.ConfirmTitle")</h1>
    </div>

    <div class="page-body checkout-data">

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="message-error">
                <ul>
                    <li>@Model.ErrorMessage</li>
                </ul>
            </div>
        }

        @if (Model.InitFailed)
        {
            <div class="section payment-info">
                <div class="title">
                    <strong>@T("Plugins.Payments.Syriatel.Ui.CheckPhone")</strong>
                </div>

                <form action="/Syriatel/RetryInit" method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-fields">
                        <div class="inputs">
                            <label asp-for="CustomerMsisdn">@T("Plugins.Payments.Syriatel.Ui.Phone")</label>
                            <input asp-for="CustomerMsisdn"
                                   autocomplete="tel"
                                   placeholder="09xxxxxxxx" />
                        </div>
                    </div>

                    <input type="hidden" asp-for="OrderId" />

                    <div class="buttons">
                        <button type="submit" class="button-1 checkout-button">
                            @T("Plugins.Payments.Syriatel.Ui.Retry")
                        </button>
                    </div>
                </form>
            </div>
        }
        else
        {
            <div class="section payment-info">
                <div class="title">
                    <strong>@T("Plugins.Payments.Syriatel.Ui.EnterCode")</strong>
                </div>

                <form asp-route="SyriatelConfirmPayment" method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-fields">
                        <div class="inputs">
                            <label asp-for="Otp">@T("Plugins.Payments.Syriatel.Ui.Code")</label>
                            <input asp-for="Otp"
                                   autocomplete="off"
                                   maxlength="6"
                                   placeholder="xxxxxx" />
                            <span asp-validation-for="Otp"></span>
                        </div>
                    </div>

                    <input type="hidden" asp-for="OrderId" />
                    <input type="hidden" asp-for="CustomerMsisdn" />

                    <div class="buttons">
                        <button type="submit" class="button-1 checkout-button">
                            @T("Plugins.Payments.Syriatel.Ui.Confirm")
                        </button>
                    </div>
                </form>

                <form asp-route="SyriatelResendOtp" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="OrderId" />
                    <input type="hidden" asp-for="CustomerMsisdn" />
                    <div class="buttons" style="margin-top: 10px;">
                        <button type="submit" class="button-1 checkout-button"
                                style="background-color: #666;">
                            @T("Plugins.Payments.Syriatel.Ui.ResendCode")
                        </button>
                    </div>
                </form>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <form action="/Syriatel/ChangePhone" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="OrderId" />
                        <input type="hidden" asp-for="CustomerMsisdn" />
                        <div class="buttons" style="margin-top: 10px;">
                            <button type="submit" class="button-1 checkout-button"
                                    style="background-color: #e74c3c;">
                                @T("Plugins.Payments.Syriatel.Ui.ChangePhone")
                            </button>
                        </div>
                    </form>
                }
            </div>
        }
    </div>
</div>
