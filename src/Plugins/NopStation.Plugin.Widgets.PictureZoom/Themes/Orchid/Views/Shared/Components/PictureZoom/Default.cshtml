@using System.Globalization
@inject Nop.Core.IWorkContext workContext
@inject PictureZoomSettings settings

@{
    var position = ((PictureZoomPosition)((await workContext.GetWorkingLanguageAsync()).Rtl ? settings.RtlPositionTypeId : settings.LtrPositionTypeId)).ToString().ToLowerInvariant();

    NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/Plugins/NopStation.Plugin.Widgets.PictureZoom/Contents/js/jquery.imagesloaded.js");
    NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/Plugins/NopStation.Plugin.Widgets.PictureZoom/Contents/js/cloud-zoom.1.0.2.js");

    NopHtml.AppendCssFileParts("~/Plugins/NopStation.Plugin.Widgets.PictureZoom/Themes/Orchid/Contents/css/cloud-zoom.css");

    var supportRtl = (await workContext.GetWorkingLanguageAsync()).Rtl;

    if (supportRtl)
    {
        NopHtml.AppendCssFileParts("~/Plugins/NopStation.Plugin.Widgets.PictureZoom/Themes/Orchid/Contents/css/styles.rtl.css");
    }
    else
    {
        NopHtml.AppendCssFileParts("~/Plugins/NopStation.Plugin.Widgets.PictureZoom/Themes/Orchid/Contents/css/styles.css");
    }

    System.Globalization.CultureInfo.DefaultThreadCurrentUICulture = new System.Globalization.CultureInfo("en-US");

}

<script type="text/javascript" asp-location="Footer">
    var position = '@position';
    var cloudZoom = function (position) {
        $("a.cloud-zoom").imagesLoaded({
            done: function ($images) {
                var width = $(".cloud-zoom-image-size").width() * @settings.ZoomWidth;
                var height = $(".cloud-zoom-image-size").height() * @settings.ZoomHeight;
                $('.cloud-zoom').CloudZoom({
                    zoomWidth: width,
                    zoomHeight: height,
                    position: position,
                    tint: @settings.Tint.ToString().ToLowerInvariant(),
                    tintOpacity: @settings.TintOpacity.ToString("N2", new CultureInfo("en-US")),
                    lensOpacity: @settings.LensOpacity.ToString("N2", new CultureInfo("en-US")),
                    softFocus: @settings.SoftFocus.ToString().ToLowerInvariant(),
                    smoothMove: @settings.SmoothMove,
                    showTitle: @settings.ShowTitle.ToString().ToLowerInvariant(),
                    titleOpacity: @settings.TitleOpacity.ToString("N2", new CultureInfo("en-US")),
                    adjustX: @settings.AdjustX,
                    adjustY: @settings.AdjustY
                });
            }
        });
    }

    var initZoom = function () {
        if ($(window).width() <= 768) {
            cloudZoom('inside');
        }
        else {
            cloudZoom(position);
        }
    };
</script>