@model ProductDetailsModel
@using Nop.Web.Components;
@using NopStation.Plugin.Misc.Core.Helpers
@inject Nop.Core.IWorkContext workContext

@{
    var settings = NopInstance.Load<PictureZoomSettings>();
    var position = ((PictureZoomPosition)((await workContext.GetWorkingLanguageAsync()).Rtl ? settings.RtlPositionTypeId : settings.LtrPositionTypeId)).ToString().ToLower();
    var supportRtl = (await workContext.GetWorkingLanguageAsync()).Rtl;

    NopHtml.AppendScriptParts(ResourceLocation.Footer, "/Plugins/NopStation.Plugin.Widgets.PictureZoom/Contents/js/jquery.imagesloaded.js");
    NopHtml.AppendScriptParts(ResourceLocation.Footer, "/Plugins/NopStation.Plugin.Widgets.PictureZoom/Contents/js/cloud-zoom.1.0.2.js");
    NopHtml.AppendCssFileParts("/Plugins/NopStation.Plugin.Widgets.PictureZoom/Contents/css/cloud-zoom.css", string.Empty);

    if (supportRtl)
    {
        NopHtml.AppendCssFileParts("/Plugins/NopStation.Plugin.Widgets.PictureZoom/Themes/NopKalles/Contents/css/styles.rtl.css", string.Empty);
    }
    else
    {
        NopHtml.AppendCssFileParts("/Plugins/NopStation.Plugin.Widgets.PictureZoom/Themes/NopKalles/Contents/css/styles.css", string.Empty);
    }
}

<div class="gallery" data-popup="#dialogForImgPopUp" style="float:left">
    <link rel="image_src" href="@Model.DefaultPictureModel.FullSizeImageUrl" />
    @await Component.InvokeAsync(typeof(WidgetViewComponent), new { widgetZone = PublicWidgetZones.ProductDetailsBeforePictures, additionalData = Model.Id })
    <a href="@Model.DefaultPictureModel.FullSizeImageUrl" class="cloud-zoom" id="cloud-zoom-link">
        <img alt="@Model.DefaultPictureModel.AlternateText" src="@Model.DefaultPictureModel.ImageUrl" title="@Model.DefaultPictureModel.Title" style="height:auto; width:100%; border-width: 0px;" class="cloud-zoom-image cloud-zoom-image-size main-product-img-@Model.Id" width="400" id="main-product-img-lightbox-anchor-@Model.Id" />
    </a>

    @if (Model.PictureModels.Count > 1)
    {
        <div class="cloud-zoom-thumb-container">
            @foreach (var picture in Model.PictureModels)
            {
                <div class="cloud-zoom-thumb">
                    <a href="@picture.FullSizeImageUrl" rel="lightbox-p" class="src-zoom-anchor" onclick="return false;" data-halfimgurl="@picture.FullSizeImageUrl">
                        <img src="@picture.ImageUrl" alt="@picture.AlternateText" title="@picture.Title" class="src-zoom-image" style="height:100px; width:100px" />
                    </a>
                </div>
            }
        </div>
    }
    <div class="imgForMobile" id="dialogForImgPopUp">
        <img alt="" src="" />
    </div>
</div>

<script type="text/javascript" asp-location="Footer">
    $(document).ready(function () {
        $('.src-zoom-anchor').on({
            'click': function () {
                var aSrc = $(this).attr('href');
                var imgSrc = $(this).attr('data-halfimgurl');
                $('.cloud-zoom-image').attr('src', imgSrc);
                $('.cloud-zoom').attr('href', aSrc);
                $("a.cloud-zoom").data('zoom').destroy();
                initZoom();
            }
        });
        initZoom();
    });

    $(window).resize(function () {
        initZoom();
    });
</script>

<script asp-location="Footer">
    $(document).ready(function () {
        // Select the node to observe
        var targetNode = document.getElementById('cloud-zoom-link');

        // Create an observer instance linked to the callback function
        var observer = new MutationObserver(function (mutationsList) {
            for (var mutation of mutationsList) {
                if (mutation.type === 'attributes' && mutation.attributeName === 'href') {
                    initZoom();
                }
            }
        });

        // Configuration of the observer
        var config = { attributes: true };

        // Start observing the target node for configured mutations
        observer.observe(targetNode, config);
    });
</script>

@if (Model.CustomProperties.TryGetValue("AjaxLoad", out string ajaxLoad) && bool.Parse(ajaxLoad.ToString()))
{
    @NopHtml.GenerateInlineScripts(ResourceLocation.Footer)
}