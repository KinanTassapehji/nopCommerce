@inject Nop.Core.IWorkContext workContext

@{
    var supportRtl = (await workContext.GetWorkingLanguageAsync()).Rtl;
    <script asp-location="@ResourceLocation.Footer"  src="~/Plugins/NopStation.Plugin.Widgets.AnywhereSlider/Content/js/nopstation.anywhereslider.js"></script>

    if (supportRtl)
    {
        <link rel="stylesheet"  href="~/Plugins/NopStation.Plugin.Widgets.AnywhereSlider/Themes/Lily/Content/css/styles.rtl.css"/>
    }
    else
    {
        <link rel="stylesheet"  href="~/Plugins/NopStation.Plugin.Widgets.AnywhereSlider/Themes/Lily/Content/css/styles.css"/>
    }
}

<script asp-location="Footer">
    var sliderdata = {};
    sliderdata.AnywereSliderFailure = '@T("NopStation.Plugin.Widgets.AnywhereSlider.LoadingFailed")';

    $(document).ready(function () {
        AnywereSlider.init('@Url.RouteUrl("AnywhereSlider")', '.slider-container', '.v .loader', sliderdata);
    })
</script>