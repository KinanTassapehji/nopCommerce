@inject Nop.Core.IWorkContext workContext

@{
    var supportRtl = (await workContext.GetWorkingLanguageAsync()).Rtl;
    NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/Plugins/NopStation.Plugin.Widgets.AnywhereSlider/Content/js/owl.carousel.min.js");
    NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/Plugins/NopStation.Plugin.Widgets.AnywhereSlider/Content/js/nopstation.anywhereslider.js");

    if (supportRtl)
    {
        NopHtml.AppendCssFileParts("~/Plugins/NopStation.Plugin.Widgets.AnywhereSlider/Content/css/rtl/owl.theme.green.min.css");
        NopHtml.AppendCssFileParts("~/Plugins/NopStation.Plugin.Widgets.AnywhereSlider/Content/css/rtl/owl.carousel.css");
        NopHtml.AppendCssFileParts("~/Plugins/NopStation.Plugin.Widgets.AnywhereSlider/Themes/Orchid/Contents/css/styles.rtl.css");
    }
    else
    {
        NopHtml.AppendCssFileParts("~/Plugins/NopStation.Plugin.Widgets.AnywhereSlider/Content/css/owl.theme.green.min.css");
        NopHtml.AppendCssFileParts("~/Plugins/NopStation.Plugin.Widgets.AnywhereSlider/Content/css/owl.carousel.css");
        NopHtml.AppendCssFileParts("~/Plugins/NopStation.Plugin.Widgets.AnywhereSlider/Themes/Orchid/Contents/css/styles.css");
    }

}

<script asp-location="Footer">
    var sliderdata = {};
    sliderdata.AnywereSliderFailure = '@T("NopStation.AnywhereSlider.LoadingFailed")';

    $(document).ready(function () {
        AnywereSlider.init('@Url.RouteUrl("AnywhereSlider")', '.slider-container', '.v .loader', sliderdata);
    });
</script>