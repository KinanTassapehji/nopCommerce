@model SliderModel

<div class="owl-carousel slider" id="slider-@(Model.Id)">
    @foreach (var item in Model.Items)
    {
        <div class="slider-item">
            <div class="slider-picture">
                <a href="@item.Link" title="@item.Title">
                    <img alt="@item.ImageAltText" src="@item.PictureUrl" title="" />
                </a>
            </div>
            @if (!string.IsNullOrWhiteSpace(item.ShortDescription) || !string.IsNullOrWhiteSpace(item.Title) || !string.IsNullOrWhiteSpace(item.ShopNowLink))
            {
                <div class="slider-caption">
                    <div class="slider-caption-inner">
                        @if (!string.IsNullOrWhiteSpace(item.Title))
                        {
                            <h2 class="slider-title">@item.Title</h2>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.ShortDescription))
                        {
                            <h3 class="slider-subtitle">@item.ShortDescription</h3>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.ShopNowLink))
                        {
                            <a href="@item.ShopNowLink" class="button-1"><i class="icon-cart-icon"></i> @T("NopStation.AnywhereSlider.Public.ShopNow")</a>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>


<script>
    $(document).ready(function () {
        $('#slider-@Model.Id').owlCarousel({
            nav: @Model.Nav.ToString().ToLowerInvariant(),
            loop: @Model.Loop.ToString().ToLowerInvariant(),
            dots: true,
            margin: @Model.Margin,
            autoplay: @Model.AutoPlay.ToString().ToLowerInvariant(),
            rtl: @Model.Rtl.ToString().ToLowerInvariant(),
            autoplayTimeout: @Model.AutoPlayTimeout,
            autoplayHoverPause: @Model.AutoPlayHoverPause.ToString().ToLowerInvariant(),
            lazyLoad: @Model.LazyLoad.ToString().ToLowerInvariant(),
            lazyLoadEager: @Model.LazyLoadEager,
            startPosition: @Model.StartPosition,
            animateOut: '@Model.AnimateOut',
            animateIn: '@Model.AnimateIn',
            responsive: {
                0: {
                    items: 1
                }
            }
        });

        $(".owl-next").html("<i class='icon-right-arrow-icon'></i>");
        $(".owl-prev").html("<i class='icon-left-arrow-icon'></i>");

    });
</script>
