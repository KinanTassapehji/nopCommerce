@model SliderModel

@if (Model.Items.Count > 0)
{
    @if (!string.IsNullOrEmpty(Model.BackGroundPictureUrl))
    {
        <div class="anywhere-slider-bg" style="background:url('@Model.BackGroundPictureUrl')no-repeat center; background-size: cover;">
            <div class="anywhere-slider-container anywhere-slider-bg-container custom-container owl-carousel container" id="anywhere-slider-@Model.Id">
                @foreach (var sliderItemModel in Model.Items)
                {

                    <div class="anywhere-slider-item">
                        <div class="slider-picture">
                            <a href="@sliderItemModel.Link" title="@sliderItemModel.Title">
                                <img alt="@sliderItemModel.ImageAltText" src="@sliderItemModel.PictureUrl" title="" />
                            </a>
                        </div>
                        <div class="slider-caption">
                            <h2 class="slider-title">@sliderItemModel.Title</h2>
                            <h3 class="slider-subtitle">@sliderItemModel.ShortDescription</h3>
                            @if (!string.IsNullOrWhiteSpace(sliderItemModel.ShopNowLink))
                            {
                                <a href="@sliderItemModel.ShopNowLink" class="slider-btn">@T("NopStation.AnywhereSlider.ShopNow")</a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="anywhere-slider-container owl-carousel" id="anywhere-slider-@Model.Id">
            @foreach (var sliderItemModel in Model.Items)
            {
                <div class="anywhere-slider-item">
                        <div class="slider-picture">
                            <a href="@sliderItemModel.Link" title="@sliderItemModel.Title">
                                <img alt="@sliderItemModel.ImageAltText" src="@sliderItemModel.PictureUrl" title="" />
                            </a>
                        </div>
                        <div class="slider-caption">
                            <h2 class="slider-title">@sliderItemModel.Title</h2>
                            <h3 class="slider-subtitle">@sliderItemModel.ShortDescription</h3>
                            @if (!string.IsNullOrWhiteSpace(sliderItemModel.ShopNowLink))
                            {
                                <a href="@sliderItemModel.ShopNowLink" class="button-1">
                                    <i class="icon-cart"></i>
                                    @T("NopStation.AnywhereSlider.ShopNow")
                                </a>
                            }
                        </div>
                </div>
            }
        </div>
    }

    @if (Model.Id == 1)
    {
        <script>
            $(document).ready(function () {
                          $('#anywhere-slider-@Model.Id').owlCarousel({
                        nav: @Model.Nav.ToString().ToLower(),
                        loop: @Model.Loop.ToString().ToLower(),
                        dots: true,
                        margin: @Model.Margin,
                        autoplay: @Model.AutoPlay.ToString().ToLower(),
                        rtl: @Model.Rtl.ToString().ToLower(),
                        autoplayTimeout: @Model.AutoPlayTimeout,
                        autoplayHoverPause: @Model.AutoPlayHoverPause.ToString().ToLower(),
                        lazyLoad: @Model.LazyLoad.ToString().ToLower(),
                        lazyLoadEager: @Model.LazyLoadEager,
                        startPosition: @Model.StartPosition,
                        animateOut: '@Model.AnimateOut',
                        animateIn: '@Model.AnimateIn',
                        responsive: {
                            0: {
                                items: 1
                            }
                        }
                    });

                    $(".owl-next").html("<i class='icon-arrow-right'></i>");
                    $(".owl-prev").html("<i class='icon-arrow-left'></i>");
                });
        </script>
    }
    else
    {
        <script>
            $(document).ready(function () {
                $('#anywhere-slider-@Model.Id').owlCarousel({
                    nav: @Model.Nav.ToString().ToLower(),
                    loop: @Model.Loop.ToString().ToLower(),
                    dots: true,
                    margin: @Model.Margin,
                    autoplay: @Model.AutoPlay.ToString().ToLower(),
                    rtl: @Model.Rtl.ToString().ToLower(),
                    autoplayTimeout: @Model.AutoPlayTimeout,
                    autoplayHoverPause: @Model.AutoPlayHoverPause.ToString().ToLower(),
                    lazyLoad: @Model.LazyLoad.ToString().ToLower(),
                    lazyLoadEager: @Model.LazyLoadEager,
                    startPosition: @Model.StartPosition,
                    animateOut: '@Model.AnimateOut',
                    animateIn: '@Model.AnimateIn',
                    responsive: {
                        0: {
                            items: 1
                        },
                        768: {
                            items: 3
                        }
                    }
                });

                $(".owl-next").html("<i class='icon-arrow-right'></i>");
                $(".owl-prev").html("<i class='icon-arrow-left'></i>");
            });
        </script>
    }
}
@NopHtml.GenerateInlineScripts(ResourceLocation.Footer)
