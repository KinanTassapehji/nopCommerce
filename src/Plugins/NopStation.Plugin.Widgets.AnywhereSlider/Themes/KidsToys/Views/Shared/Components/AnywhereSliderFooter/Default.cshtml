@using Nop.Web.Framework.Themes
@inject Nop.Core.IWorkContext workContext
@inject IThemeContext themeContext

@{
    var supportRtl = (await workContext.GetWorkingLanguageAsync()).Rtl;
    var themeName = await themeContext.GetWorkingThemeNameAsync();

    NopHtml.AppendScriptParts(ResourceLocation.Footer, $"~/Plugins/NopStation.Plugin.Widgets.AnywhereSlider/Themes/{themeName}/Content/js/nopstation.anywhereslider.js");

    if (supportRtl)
    {
        NopHtml.AppendCssFileParts($"~/Plugins/NopStation.Plugin.Widgets.AnywhereSlider/Themes/{themeName}/Content/css/rtl/owl.theme.green.min.css");
        //NopHtml.AppendCssFileParts($"~/Plugins/NopStation.Plugin.Widgets.AnywhereSlider/Themes/{themeName}/Content/css/rtl/owl.carousel.css");
    }
    else
    {
        NopHtml.AppendCssFileParts($"~/Plugins/NopStation.Plugin.Widgets.AnywhereSlider/Themes/{themeName}/Content/css/owl.theme.green.min.css");
        //NopHtml.AppendCssFileParts($"~/Plugins/NopStation.Plugin.Widgets.AnywhereSlider/Themes/{themeName}/Content/css/owl.carousel.css");
    }

    NopHtml.AppendCssFileParts($"~/Plugins/NopStation.Plugin.Widgets.AnywhereSlider/Themes/{themeName}/Content/css/styles.css");
}

<script asp-location="Footer">
    var sliderdata = {};
    sliderdata.AnywereSliderFailure = '@T("NopStation.Plugin.Widgets.AnywhereSlider.LoadingFailed")';

    $(document).ready(function () {
        AnywereSlider.init('@Url.RouteUrl("AnywhereSlider")', '.slider-container', '.v .loader', sliderdata);
    });
</script>