@model SliderListModel

@foreach (var slider in Model.Sliders)
{
    var bg = slider.ShowBackgroundPicture ? $"style=\"background:url('{slider.BackgroundPictureUrl}') no-repeat center; background-size: cover;\"" : "";

    <div class="slider-grid @Html.Raw(slider.ShowBackgroundPicture? "slider-grid-background" : "")" style="background: url('@slider.BackgroundPictureUrl') no-repeat center; background-size: cover">
        <div class=" @Html.Raw(slider.ShowBackgroundPicture? "slider-container container" : "slider-container")" data-sliderid="@slider.Id">
            <div class="loader">
                <div class="lds-dual-ring"></div>
            </div>
        </div>
    </div>
}