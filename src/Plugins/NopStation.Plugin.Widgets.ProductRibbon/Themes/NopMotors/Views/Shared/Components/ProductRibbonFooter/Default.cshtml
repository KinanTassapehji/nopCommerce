@using Nop.Core
@inject IWorkContext workContext

@{
    if ((await workContext.GetWorkingLanguageAsync()).Rtl)
    {
        NopHtml.AppendCssFileParts("/Plugins/NopStation.Plugin.Widgets.ProductRibbon/Themes/NopMotors/Contents/css/styles.rtl.css");
    }
    else
    {
        NopHtml.AppendCssFileParts("/Plugins/NopStation.Plugin.Widgets.ProductRibbon/Themes/NopMotors/Contents/css/styles.css");
    }
}