@using Nop.Core
@inject IWorkContext workContext

@{
    var supportRtl = (await workContext.GetWorkingLanguageAsync()).Rtl;

    if (supportRtl)
    {
        <link rel="stylesheet" href="~/Plugins/NopStation.Plugin.Widgets.ProductRibbon/Themes/KidsToys/Contents/css/styles.rtl.css"/>
    }
    else
    {
        <link rel="stylesheet" href="~/Plugins/NopStation.Plugin.Widgets.ProductRibbon/Themes/KidsToys/Contents/css/styles.css" />
    }
}