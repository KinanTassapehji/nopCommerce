@using Nop.Core
@inject IWorkContext workContext

@{
    var supportRtl = (await workContext.GetWorkingLanguageAsync()).Rtl;

    if (supportRtl)
    {
        NopHtml.AddCssFileParts($"/Plugins/NopStation.Plugin.Widgets.ProductRibbon/Themes/Rosea/Contents/css/styles.rtl.css");
    }
    else
    {
        NopHtml.AddCssFileParts($"/Plugins/NopStation.Plugin.Widgets.ProductRibbon/Themes/Rosea/Contents/css/styles.css");
    }
}